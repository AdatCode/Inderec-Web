<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar producto</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{
      background: #f5f7fb;
    }

    .topbar{
      background: linear-gradient(135deg, #111827, #1f2937);
    }

    .form-card{
      max-width: 980px;
      margin: 34px auto;
      border: none;
      border-radius: 18px;
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
    }

    .page-title{
      font-weight: 700;
      color: #111827;
      margin-bottom: 4px;
    }

    .page-subtitle{
      color: #6b7280;
      font-size: .95rem;
      margin-bottom: 24px;
    }

    .form-label{
      font-weight: 600;
      color: #374151;
      margin-bottom: 6px;
    }

    .form-control,
    .form-select{
      border-radius: 12px;
      border: 1px solid #dbe1ea;
      padding-top: .62rem;
      padding-bottom: .62rem;
    }

    .form-control:focus,
    .form-select:focus{
      border-color: #2563eb;
      box-shadow: 0 0 0 .2rem rgba(37, 99, 235, 0.12);
    }

    textarea.form-control{
      min-height: 110px;
    }

    .section-box{
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 18px;
    }

    .hint{
      font-size: .82rem;
      color: #6b7280;
      margin-top: 5px;
    }

    .preview-img{
      width: 95px;
      height: 95px;
      object-fit: cover;
      border-radius: 12px;
      border: 1px solid #d1d5db;
      background: white;
    }
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark topbar shadow-sm">
    <div class="container">
      <span class="navbar-brand fw-bold">Panel de Administración</span>

      <div class="d-flex gap-2 align-items-center">
        <a href="/admin/dashboard" class="btn btn-outline-light btn-sm">Dashboard</a>
        <a href="/admin/productos" class="btn btn-outline-light btn-sm">Productos</a>
        <a href="/logout" class="btn btn-light btn-sm">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="card form-card">
      <div class="card-body p-4 p-lg-4">

        <h2 class="page-title">Editar producto</h2>
        <p class="page-subtitle">Actualiza la información principal del producto.</p>

        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="/admin/productos/actualizar/<%= producto.id %>" method="POST" enctype="multipart/form-data">
          <div class="section-box mb-3">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input type="text" name="nombre" class="form-control" value="<%= producto.nombre %>" required>
              </div>

              <div class="col-md-3">
                <label class="form-label">Marca</label>
                <input type="text" name="marca" class="form-control" value="<%= producto.marca || '' %>" required>
              </div>

              <div class="col-md-3">
                <label class="form-label">Categoría</label>
                <select name="categoria_id" class="form-select" required>
                  <option value="">Seleccione</option>
                  <% categorias.forEach(categoria => { %>
                    <option value="<%= categoria.id %>" <%= Number(producto.categoria_id) === Number(categoria.id) ? 'selected' : '' %>>
                      <%= categoria.nombre %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label">Descripción</label>
                <textarea name="descripcion" class="form-control" required><%= producto.descripcion %></textarea>
              </div>
            </div>
          </div>

          <div class="section-box mb-3">
            <div class="row g-3">
              <div class="col-md-2">
                <label class="form-label">Stock</label>
                <input type="number" name="stock" class="form-control" min="0" value="<%= producto.stock %>" required>
              </div>

              <div class="col-md-2">
                <label class="form-label">Precio</label>
                <input type="number" step="0.01" name="precio" class="form-control" min="0" value="<%= producto.precio %>" required>
              </div>

              <div class="col-md-4">
                <label class="form-label">Ubicación</label>
                <input type="text" name="ubicacion_rack" class="form-control" value="<%= producto.ubicacion_rack || '' %>">
              </div>

              <div class="col-md-4">
                <label class="form-label">Enlace de referencia</label>
                <input type="url" name="enlace_referencia" class="form-control" value="<%= producto.enlace_referencia || '' %>">
              </div>
            </div>
          </div>

          <div class="section-box mb-4">
            <div class="row g-3 align-items-center">
              <div class="col-md-4">
                <label class="form-label">Imagen actual</label><br>
                <% if (producto.imagen) { %>
                  <img src="<%= producto.imagen %>" alt="Imagen actual" class="preview-img">
                <% } else { %>
                  <span class="text-muted">Sin imagen</span>
                <% } %>
              </div>

              <div class="col-md-8">
                <label class="form-label">Nueva imagen</label>
                <input type="file" name="imagen" class="form-control" accept="image/*">
                <div class="hint">Solo cambia la imagen si deseas reemplazar la actual.</div>
              </div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary px-4">Actualizar producto</button>
            <a href="/admin/productos" class="btn btn-secondary">Cancelar</a>
          </div>
        </form>

      </div>
    </div>
  </div>

</body>
</html>