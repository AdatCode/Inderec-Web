<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar producto</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --oscuro:#111827;
      --gris:#64748b;
      --borde:#e5e7eb;
      --fondo:#f5f7fb;
      --amarillo:#f4b400;
      --verde:#16a34a;
      --azul:#2563eb;
    }

    body{
      background:#f5f7fb;
      color:#111827;
      font-family:Arial, sans-serif;
    }

    .topbar{
      background:#1f2429;
      box-shadow:0 6px 18px rgba(15,23,42,.12);
    }

    .navbar-brand{
      font-weight:800;
      letter-spacing:.2px;
    }

    .btn-nav{
      border-radius:8px;
      font-weight:700;
    }

    .page-wrap{
      max-width:1120px;
      margin:0 auto;
      padding:24px 14px 45px;
    }

    .edit-card{
      background:#ffffff;
      border:1px solid #edf1f7;
      border-radius:22px;
      box-shadow:0 14px 34px rgba(15,23,42,.07);
      overflow:hidden;
    }

    .edit-header{
      padding:22px 26px 16px;
      background:linear-gradient(135deg, #ffffff, #f8fafc);
      border-bottom:1px solid #eef2f7;
    }

    .edit-title{
      font-size:1.75rem;
      font-weight:900;
      color:#111827;
      margin:0;
      letter-spacing:.2px;
    }

    .edit-subtitle{
      margin-top:6px;
      color:#64748b;
      font-weight:600;
      font-size:.92rem;
    }

    .edit-body{
      padding:22px 26px 26px;
    }

    .section-card{
      background:#ffffff;
      border:1px solid #e5e7eb;
      border-radius:18px;
      padding:17px;
      margin-bottom:15px;
      box-shadow:0 6px 16px rgba(15,23,42,.035);
    }

    .section-title{
      display:flex;
      align-items:center;
      gap:9px;
      font-weight:900;
      color:#111827;
      margin-bottom:15px;
      font-size:.96rem;
    }

    .section-title .icon{
      width:30px;
      height:30px;
      border-radius:11px;
      background:#fff7db;
      display:flex;
      align-items:center;
      justify-content:center;
      border:1px solid #fde68a;
      font-size:.9rem;
    }

    .form-label{
      font-weight:800;
      color:#1f2937;
      margin-bottom:6px;
      font-size:.9rem;
    }

    .form-control,
    .form-select{
      border-radius:13px;
      border:1px solid #dbe3ee;
      padding:10px 13px;
      font-weight:600;
      color:#111827;
      box-shadow:none;
      font-size:.94rem;
    }

    .form-control:focus,
    .form-select:focus{
      border-color:#f4b400;
      box-shadow:0 0 0 .2rem rgba(244,180,0,.14);
    }

    textarea.form-control{
      min-height:112px;
      resize:vertical;
      line-height:1.45;
    }

    .helper-text{
      margin-top:6px;
      color:#94a3b8;
      font-size:.78rem;
      font-weight:700;
    }

    .admin-grid{
      display:grid;
      grid-template-columns:160px 170px 1fr;
      gap:14px;
    }

    .image-grid{
      display:grid;
      grid-template-columns:210px 1fr;
      gap:18px;
      align-items:center;
    }

    .current-image-box{
      background:#f8fafc;
      border:1px solid #e5e7eb;
      border-radius:16px;
      padding:10px;
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:150px;
      overflow:hidden;
    }

    .current-image-box img{
      width:100%;
      height:130px;
      object-fit:contain;
      border-radius:12px;
      background:#ffffff;
    }

    .no-image{
      width:100%;
      height:130px;
      border-radius:12px;
      background:#ffffff;
      border:1px dashed #cbd5e1;
      display:flex;
      align-items:center;
      justify-content:center;
      color:#94a3b8;
      font-weight:900;
      font-size:.9rem;
    }

    .file-box{
      background:linear-gradient(135deg, #ffffff, #f8fafc);
      border:1px solid #e5e7eb;
      border-radius:16px;
      padding:16px;
    }

    .file-note{
      color:#64748b;
      font-size:.82rem;
      margin-top:8px;
      font-weight:600;
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top:6px;
    }

    .btn-main{
      border:none;
      border-radius:13px;
      padding:10px 17px;
      font-weight:900;
      background:linear-gradient(135deg, #f4b400, #e3a700);
      color:#111827;
      box-shadow:0 8px 18px rgba(244,180,0,.20);
    }

    .btn-main:hover{
      background:linear-gradient(135deg, #ffd65a, #f4b400);
      color:#111827;
      transform:translateY(-1px);
    }

    .btn-cancel{
      border:none;
      border-radius:13px;
      padding:10px 17px;
      font-weight:900;
      background:#475569;
      color:#ffffff;
      text-decoration:none;
    }

    .btn-cancel:hover{
      background:#334155;
      color:#ffffff;
      transform:translateY(-1px);
    }

    .btn-detail{
      border-radius:13px;
      padding:10px 17px;
      font-weight:900;
      background:#ffffff;
      border:1px solid #dbe3ee;
      color:#475569;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:7px;
    }

    .btn-detail:hover{
      background:#f8fafc;
      color:#111827;
      transform:translateY(-1px);
    }

    @media(max-width:992px){
      .admin-grid{
        grid-template-columns:1fr;
      }

      .image-grid{
        grid-template-columns:1fr;
      }
    }

    @media(max-width:576px){
      .page-wrap{
        padding:18px 10px 35px;
      }

      .edit-header,
      .edit-body{
        padding-left:16px;
        padding-right:16px;
      }

      .edit-title{
        font-size:1.45rem;
      }

      .section-card{
        padding:15px;
      }

      .actions{
        display:grid;
        grid-template-columns:1fr;
      }

      .actions .btn,
      .actions a{
        width:100%;
      }
    }
    .admin-actions{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}

.btn-admin-gold{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  border:none;
  border-radius:999px;
  padding:7px 10px;
  background:linear-gradient(135deg, #f4b400, #ffd65a);
  color:#111827;
  font-weight:900;
  font-size:.92rem;
  text-decoration:none;
  box-shadow:0 10px 22px rgba(244,180,0,.22);
  transition:all .18s ease;
}

.btn-admin-gold:hover{
  color:#111827;
  transform:translateY(-2px);
  background:linear-gradient(135deg, #ffd65a, #f4b400);
  box-shadow:0 14px 28px rgba(244,180,0,.32);
}

.btn-admin-gold:active{
  transform:translateY(0);
}

@media(max-width:576px){
  .admin-actions{
    width:100%;
    display:grid;
    grid-template-columns:1fr;
  }

  .btn-admin-gold{
    width:100%;
  }
}
  </style>
</head>

<body>
  <% 
    const productoId = producto.id || producto.id_producto;

    const categoriaSeleccionada = 
      producto.categoria_id || 
      producto.id_categoria || 
      producto.categoriaId || 
      '';

    const precioNumero = Number(String(producto.precio || 0).replace(',', '.'));
    const precioValor = Number.isFinite(precioNumero) ? precioNumero.toFixed(2) : '0.00';

    const ubicacionValor = producto.ubicacion_rack || producto.ubicacion || '';
  %>

  <nav class="navbar navbar-expand-lg navbar-dark topbar">
    <div class="container py-2">
      <a class="navbar-brand" href="/admin/dashboard">Sistema Catálogo</a>

     <div class="admin-actions">
          <a href="/admin/dashboard" class="btn-admin-gold">
            🏠 Panel admin
          </a>

          <a href="/logout" class="btn-admin-gold">
            🔒 Cerrar sesión
          </a>
    </div>
    </div>
  </nav>

  <main class="page-wrap">
    <div class="edit-card">
      <div class="edit-header">
        <h1 class="edit-title">Editar producto</h1>
      </div>

      <div class="edit-body">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger rounded-4 fw-bold">
            <%= error %>
          </div>
        <% } %>

        <form 
          action="/admin/productos/editar/<%= productoId %>" 
          method="POST" 
          enctype="multipart/form-data"
        >

          <div class="section-card">
            <div class="section-title">
              <span class="icon">📝</span>
              Información principal
            </div>

            <div class="row g-3">
              <div class="col-lg-6">
                <label class="form-label">Nombre</label>
                <input 
                  type="text" 
                  name="nombre" 
                  class="form-control" 
                  value="<%= producto.nombre || '' %>" 
                  required
                >
              </div>

              <div class="col-lg-3">
                <label class="form-label">Marca</label>
                <input 
                  type="text" 
                  name="marca" 
                  class="form-control" 
                  value="<%= producto.marca || '' %>"
                  placeholder="Ej: JSL"
                >
              </div>

              <div class="col-lg-3">
                <label class="form-label">Categoría</label>
                <select name="categoria_id" class="form-select" required>
                  <% categorias.forEach(categoria => { %>
                    <option 
                      value="<%= categoria.id %>"
                      <%= 
                        String(categoria.id) === String(categoriaSeleccionada) || 
                        String(categoria.nombre) === String(producto.categoria || producto.categoria_nombre || '') 
                          ? 'selected' 
                          : '' 
                      %>
                    >
                      <%= categoria.nombre %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label">Descripción</label>
                <textarea 
                  name="descripcion" 
                  class="form-control"
                  placeholder="Describe las características principales del producto..."
                ><%= producto.descripcion || '' %></textarea>
              </div>
            </div>
          </div>

          <div class="section-card">
            <div class="section-title">
              <span class="icon">📦</span>
              Datos internos
            </div>

            <div class="admin-grid">
              <div>
                <label class="form-label">Stock</label>
                <input 
                  type="number" 
                  name="stock" 
                  class="form-control" 
                  value="<%= producto.stock || 0 %>" 
                  min="0" 
                  required
                >
                
              </div>

              <div>
                <label class="form-label">Precio interno</label>
                <input 
                  type="text"
                  name="precio"
                  id="precioInput"
                  class="form-control"
                  value="<%= precioValor %>"
                  placeholder="Ej: 7.01"
                  inputmode="decimal"
                >
                
              </div>

              <div>
                <label class="form-label">Ubicación Interna</label>
                <input 
                  type="text" 
                  name="ubicacion_rack" 
                  class="form-control" 
                  value="<%= ubicacionValor %>" 
                  placeholder="Ej: Rack S3 - Nivel 2"
                >
                
              </div>
            </div>
          </div>

          <div class="section-card">
            <div class="section-title">
              <span class="icon">🖼️</span>
              Imagen del producto
            </div>

            <div class="image-grid">
              <div>
                <label class="form-label">Imagen actual</label>

                <div class="current-image-box">
                  <% if (producto.imagen) { %>
                    <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>">
                  <% } else { %>
                    <div class="no-image">Sin imagen</div>
                  <% } %>
                </div>
              </div>

              <div class="file-box">
                <label class="form-label">Nueva imagen</label>
                <input 
                  type="file" 
                  name="imagen" 
                  class="form-control" 
                  accept="image/*"
                >
                <div class="file-note">
                  Selecciona una nueva imagen solo si deseas reemplazar la actual.
                </div>
              </div>
            </div>
          </div>

          <div class="actions">
            <button type="submit" class="btn btn-main">
              💾 Guardar cambios
            </button>

            <a href="/admin/productos" class="btn btn-cancel">
              Cancelar
            </a>

            <a href="/catalogo/producto/<%= productoId %>" class="btn-detail">
              👁️ Ver detalle
            </a>
          </div>

        </form>
      </div>
    </div>
  </main>

  <script>
    const precioInput = document.getElementById('precioInput');

    if (precioInput) {
      precioInput.addEventListener('input', () => {
        precioInput.value = precioInput.value.replace(',', '.');
      });
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>