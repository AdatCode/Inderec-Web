<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar categoría</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{
      background:#f5f7fb;
    }
    .topbar{
      background:linear-gradient(135deg,#111827,#1f2937);
    }
    .form-card{
      border:none;
      border-radius:22px;
      box-shadow:0 12px 30px rgba(15,23,42,.07);
    }
    .form-label{
      font-weight:600;
      color:#374151;
      margin-bottom:6px;
    }
    .form-control{
      border-radius:12px;
      border:1px solid #dbe1ea;
      padding-top:.62rem;
      padding-bottom:.62rem;
    }
    .form-control:focus{
      border-color:#7c3aed;
      box-shadow:0 0 0 .2rem rgba(124,58,237,.12);
    }

    .numero-wrap{
      display:flex;
      justify-content:center;
      margin-bottom:1.2rem;
    }

    .numero-box{
      width:130px;
      text-align:center;
    }

    .numero-box .form-label{
      display:block;
      text-align:center;
      color:#6d28d9;
      font-weight:700;
      font-size:.95rem;
    }

    .numero-box .form-control{
      text-align:center;
      font-weight:800;
      font-size:1.1rem;
      color:#4c1d95;
      background:linear-gradient(135deg,#f5f3ff,#ede9fe);
      border:1px solid #c4b5fd;
      box-shadow:0 8px 18px rgba(124,58,237,.10);
    }

    .numero-box .form-control:focus{
      border-color:#8b5cf6;
      box-shadow:0 0 0 .2rem rgba(139,92,246,.16);
      background:#fff;
    }
  </style>
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark topbar">
    <div class="container">
      <a href="/admin/dashboard" class="navbar-brand">Panel Admin</a>
      <div class="d-flex gap-2">
        <a href="/admin/categorias" class="btn btn-outline-light btn-sm">Volver</a>
        <a href="/logout" class="btn btn-light btn-sm">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card form-card">
          <div class="card-body p-4">
            <h3 class="mb-4 fw-bold text-center">Editar categoría</h3>

            <% if (error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form action="/admin/categorias/actualizar/<%= categoria.id %>" method="POST">
              <div class="numero-wrap">
                <div class="numero-box">
                  <label class="form-label">N°</label>
                  <input type="number" name="orden" class="form-control" min="1" value="<%= categoria.orden || '' %>" required>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input type="text" name="nombre" class="form-control" value="<%= categoria.nombre %>" required>
              </div>

              <div class="d-flex justify-content-center gap-2">
                <button type="submit" class="btn btn-primary">Actualizar categoría</button>
                <a href="/admin/categorias" class="btn btn-secondary">Cancelar</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

</body>
</html>