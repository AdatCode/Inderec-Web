<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Productos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{
      background: #f5f7fb;
    }

    .topbar{
      background: linear-gradient(135deg, #111827, #1f2937);
    }

    .hero-card{
      border: none;
      border-radius: 20px;
      background: linear-gradient(135deg, #0f766e, #14b8a6);
      color: white;
      overflow: hidden;
      position: relative;
    }

    .hero-card::after{
      content: "";
      position: absolute;
      right: -35px;
      top: -35px;
      width: 160px;
      height: 160px;
      background: rgba(255,255,255,0.08);
      border-radius: 50%;
    }

    .hero-card::before{
      content: "";
      position: absolute;
      right: 30px;
      bottom: -45px;
      width: 120px;
      height: 120px;
      background: rgba(255,255,255,0.06);
      border-radius: 50%;
    }

    .hero-content{
      position: relative;
      z-index: 1;
    }

    .table-card{
      border: none;
      border-radius: 18px;
    }

    .producto-img{
      width: 62px;
      height: 62px;
      object-fit: cover;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      background: #fff;
    }

    .badge-soft{
      background: #eef2ff;
      color: #3730a3;
      border-radius: 999px;
      padding: 6px 10px;
      font-weight: 600;
      font-size: .78rem;
    }

    .table thead th{
      white-space: nowrap;
      vertical-align: middle;
    }

    .table td{
      vertical-align: middle;
    }

    .acciones{
      min-width: 340px;
    }

    .acciones-producto{
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: nowrap;
    }

    .acciones-producto .btn{
      border-radius: 10px;
      padding: 8px 14px;
      font-weight: 600;
      white-space: nowrap;
    }

    .acciones-producto form{
      margin: 0;
    }

    .titulo-seccion{
      font-weight: 700;
      color: #111827;
    }

    .subtitulo-seccion{
      color: #6b7280;
      font-size: .95rem;
    }

    @media (max-width: 1200px){
      .acciones{
        min-width: 280px;
      }

      .acciones-producto{
        flex-wrap: wrap;
      }
    }
    .admin-nav-actions{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}

.admin-nav-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  padding:7px 10px;
  border-radius:999px;
  background:linear-gradient(135deg, #f4b400, #ffd65a);
  color:#111827;
  font-size:.92rem;
  font-weight:900;
  text-decoration:none;
  border:none;
  box-shadow:0 10px 22px rgba(244,180,0,.22);
  transition:all .18s ease;
  white-space:nowrap;
}

.admin-nav-btn:hover{
  color:#111827;
  transform:translateY(-2px);
  background:linear-gradient(135deg, #ffd65a, #f4b400);
  box-shadow:0 14px 28px rgba(244,180,0,.32);
}

  .admin-nav-btn:active{
  transform:translateY(0);
}

  @media(max-width:576px){
  .admin-nav-actions{
    width:100%;
    display:grid;
    grid-template-columns:1fr;
  }

  .admin-nav-btn{
    width:100%;
    }
  }
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark topbar shadow-sm">
    <div class="container">
      <span class="navbar-brand fw-bold">Panel de Administración</span>

      <div class="admin-nav-actions">
      <a href="/admin/dashboard" class="admin-nav-btn">
        🏠 Inicio
      </a>

      <a href="/catalogo" class="admin-nav-btn">
        🛍️ Ver catálogo
      </a>

      <a href="/logout" class="admin-nav-btn">
        🔒 Cerrar sesión
      </a>
    </div>
    </div>
  </nav>

  <div class="container py-4 py-lg-5">

    <div class="card hero-card shadow-lg mb-4">
      <div class="card-body p-4 p-lg-5 hero-content">
        <div class="row g-3 align-items-center">
          <div class="col-lg-8">
            <h2 class="fw-bold mb-2">Gestión de productos</h2>
          </div>

          <div class="col-lg-4 text-lg-end">
            <a href="/admin/productos/crear" class="btn btn-light fw-semibold">
              + Nuevo producto
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-4">
      <h3 class="titulo-seccion mb-1">Listado de productos</h3>
    </div>

    <div class="card shadow-sm table-card">
      <div class="card-body p-3 p-md-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Categoría</th>
                <th>Stock</th>
                <th>Precio</th>
                <th>Ubicación</th>
                <th>Estado</th>
                <th class="acciones">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (productos.length === 0) { %>
                <tr>
                  <td colspan="10" class="text-center py-4 text-muted">No hay productos registrados</td>
                </tr>
              <% } %>

              <% productos.forEach(producto => { %>
                <tr>
                  <td>
                    <span class="badge-soft">#<%= producto.id %></span>
                  </td>

                  <td>
                    <% if (producto.imagen) { %>
                      <img src="<%= producto.imagen %>" class="producto-img" alt="<%= producto.nombre %>">
                    <% } else { %>
                      <div class="producto-img d-flex align-items-center justify-content-center text-muted small">
                        Sin imagen
                      </div>
                    <% } %>
                  </td>

                  <td class="fw-semibold"><%= producto.nombre %></td>
                  <td><%= producto.marca || 'Sin marca' %></td>
                  <td><%= producto.categoria || 'Sin categoría' %></td>
                  <td><%= producto.stock %></td>
                  <td>$<%= Number(producto.precio).toFixed(2) %></td>
                  <td><%= producto.ubicacion_rack || '-' %></td>
                  <td>
                    <% if (producto.estado === 'activo') { %>
                      <span class="badge text-bg-success">Activo</span>
                    <% } else { %>
                      <span class="badge text-bg-secondary">Inactivo</span>
                    <% } %>
                  </td>

                  <td class="acciones">
                    <div class="acciones-producto">
                      <a href="/admin/productos/editar/<%= producto.id %>" class="btn btn-warning btn-sm">
                        Editar
                      </a>

                      <form action="/admin/productos/eliminar/<%= producto.id %>" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este producto?')">
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                      </form>

                      <a href="/catalogo/producto/<%= producto.id %>" class="btn btn-success btn-sm">
                        Ver detalle
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

</body>
</html>