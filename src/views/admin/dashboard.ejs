<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Administrador</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --amarillo: #f4b400;
      --amarillo-suave: #ffd65a;
      --gris-fondo: #eef2f6;
      --gris-texto: #667085;
      --gris-borde: #dbe2ea;
      --gris-icono-1: #f8fafc;
      --gris-icono-2: #eef2f7;
      --oscuro: #1f2937;
      --oscuro-2: #111827;
      --blanco: #ffffff;
      --azul-2: #2563eb;
    }

    *{
      box-sizing: border-box;
    }

    body{
      background:
        radial-gradient(circle at 10% 15%, rgba(244,180,0,0.08), transparent 18%),
        radial-gradient(circle at 90% 80%, rgba(255,255,255,0.65), transparent 16%),
        linear-gradient(135deg, #eef2f6, #f7f8fb, #eef1f5);
      min-height: 100vh;
      margin: 0;
      font-family: Arial, sans-serif;
      color: var(--oscuro);
    }

    .topbar{
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.96), rgba(0, 0, 0, 0.96));
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(160,174,192,0.18);
      box-shadow: 0 8px 20px rgba(4, 255, 25, 0.05);
    }

    .brand-wrap{
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-logo{
      width: 100px;
      height: 40px;
      object-fit: contain;
      display: block;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,.10));
    }

    .hello-text{
      color: #ffffff;
      font-size: .90rem;
      font-weight: 1000;
    }

    .btn-nav{
      border-radius: 999px;
      font-weight: 700;
      padding: 10px 18px;
      border: none;
      background: linear-gradient(135deg, var(--amarillo), #e7a900);
      color: #1f2937;
      box-shadow: 0 8px 18px rgba(244,180,0,0.18);
      transition: all .18s ease;
    }

    .btn-nav:hover{
      transform: translateY(-1px);
      background: linear-gradient(135deg, var(--amarillo-suave), var(--amarillo));
      color: #111827;
    }

    .dashboard-wrap{
      padding: 34px 0 46px;
    }

    /* ===========================
       HERO PREMIUM ALEATORIO
    ============================ */

    .hero-card{
      --hero-accent: #f4b400;
      --hero-glow: rgba(244,180,0,.75);
      --hero-radial: rgba(244,180,0,.22);

      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 30px;
      background:
        radial-gradient(circle at 86% 45%, var(--hero-radial), transparent 28%),
        radial-gradient(circle at 96% 12%, rgba(255,255,255,0.08), transparent 22%),
        linear-gradient(135deg, #05070d 0%, #101827 42%, #111827 72%, #07090f 100%);
      background-size: 180% 180%;
      box-shadow:
        0 26px 55px rgba(15,23,42,0.24),
        inset 0 1px 0 rgba(255,255,255,0.08);
      overflow: hidden;
      position: relative;
      animation: heroEntrada .65s ease both, heroFondoPremium 8s ease-in-out infinite;
    }

    .hero-card::before{
      content: "";
      position: absolute;
      left: 36px;
      top: 69%;
      width: 320px;
      height: 2px;
      background: linear-gradient(90deg, var(--hero-accent), var(--hero-radial), transparent);
      box-shadow: 0 0 18px var(--hero-glow);
      animation: lineaBrilloPremium 3.4s ease-in-out infinite;
      z-index: 2;
    }

    .hero-card::after{
      content: "";
      position: absolute;
      right: -90px;
      top: -120px;
      width: 380px;
      height: 380px;
      border-radius: 50%;
      background: rgba(255,255,255,0.07);
      animation: orbGrandePremium 7s ease-in-out infinite;
      z-index: 1;
    }

    .hero-orb{
      position: absolute;
      right: -48px;
      bottom: -118px;
      width: 670px;
      height: 350px;
      border-radius: 55% 45% 0 0;
      background:
        linear-gradient(135deg, var(--hero-radial), rgba(255,255,255,0.04) 65%, transparent);
      transform: rotate(-10deg);
      animation: curvaPremium 8s ease-in-out infinite;
      z-index: 1;
    }

    .hero-orb::before{
      content: "";
      position: absolute;
      inset: 28px;
      border-radius: inherit;
      border-top: 3px solid var(--hero-accent);
      border-left: 1px solid var(--hero-radial);
      opacity: .95;
    }

    .hero-orb::after{
      content: "";
      position: absolute;
      right: 95px;
      bottom: 72px;
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: var(--hero-radial);
      filter: blur(28px);
    }

    .hero-dots{
      position: absolute;
      right: 360px;
      bottom: 45px;
      width: 150px;
      height: 120px;
      opacity: .16;
      background-image: radial-gradient(rgba(255,255,255,.75) 1px, transparent 1px);
      background-size: 14px 14px;
      animation: dotsFlotando 6s ease-in-out infinite;
      z-index: 1;
    }

    .hero-mark{
      position: absolute;
      right: 92px;
      top: 72px;
      width: 110px;
      height: 80px;
      opacity: .18;
      animation: marcaBrillo 5s ease-in-out infinite;
      z-index: 2;
    }

    .hero-mark::before,
    .hero-mark::after{
      content: "";
      position: absolute;
      width: 62px;
      height: 18px;
      background: linear-gradient(135deg, var(--hero-accent), #ffffff);
      border-radius: 4px;
    }

    .hero-mark::before{
      left: 5px;
      top: 24px;
      transform: skewY(-28deg);
    }

    .hero-mark::after{
      right: 5px;
      top: 24px;
      transform: skewY(28deg);
      opacity: .65;
    }

    .hero-body{
      padding: 54px 36px 52px;
      position: relative;
      z-index: 3;
      isolation: isolate;
    }

    .hero-body::after{
      content:"";
      position:absolute;
      top:-45%;
      left:-45%;
      width:45%;
      height:195%;
      background:linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.10),
        var(--hero-radial),
        transparent
      );
      transform:rotate(18deg);
      animation:luzCruzando 5.8s ease-in-out infinite;
      pointer-events:none;
      z-index:-1;
    }

    .hero-title{
      font-size: 2.8rem;
      font-weight: 900;
      margin-bottom: 8px;
      color: white;
      letter-spacing: .3px;
      text-shadow: 0 8px 24px rgba(0,0,0,.35);
      animation: tituloGlow 4s ease-in-out infinite;
    }

    /* ===========================
       VARIANTES ALEATORIAS
    ============================ */

    .hero-curve .hero-orb{
      border-radius:55% 45% 0 0;
    }

    .hero-curve .hero-dots{
      display:block;
    }

    .hero-rings .hero-orb{
      right:-120px;
      bottom:-140px;
      width:520px;
      height:520px;
      border-radius:50%;
      background:transparent;
      border:3px solid var(--hero-accent);
      box-shadow:
        0 0 45px var(--hero-glow),
        inset 0 0 45px var(--hero-radial);
      opacity:.45;
    }

    .hero-rings .hero-orb::before{
      inset:55px;
      border-radius:50%;
      border:2px solid var(--hero-radial);
    }

    .hero-rings .hero-orb::after{
      right:120px;
      bottom:120px;
      width:170px;
      height:170px;
      background:var(--hero-radial);
    }

    .hero-rings .hero-dots{
      right:55px;
      bottom:55px;
    }

    .hero-diagonal .hero-orb{
      right:-160px;
      bottom:-90px;
      width:760px;
      height:280px;
      border-radius:38px;
      transform:rotate(-18deg);
      background:linear-gradient(
        135deg,
        var(--hero-radial),
        rgba(255,255,255,.05),
        transparent
      );
    }

    .hero-diagonal .hero-orb::before{
      inset:28px;
      border-radius:30px;
      border-top:3px solid var(--hero-accent);
      border-left:none;
    }

    .hero-diagonal .hero-mark{
      right:140px;
      top:55px;
    }

    .hero-waves .hero-orb{
      right:-80px;
      bottom:-135px;
      width:720px;
      height:360px;
      border-radius:60% 40% 45% 55%;
      background:
        radial-gradient(circle at 30% 40%, var(--hero-radial), transparent 35%),
        linear-gradient(135deg, var(--hero-radial), transparent 70%);
    }

    .hero-waves .hero-orb::before{
      inset:36px;
      border-radius:inherit;
      border-top:3px solid var(--hero-accent);
      border-left:0;
    }

    .hero-waves .hero-dots{
      right:270px;
      bottom:36px;
    }

    .hero-spotlight{
      background:
        radial-gradient(circle at 78% 45%, var(--hero-radial), transparent 32%),
        radial-gradient(circle at 22% 20%, rgba(255,255,255,.08), transparent 24%),
        linear-gradient(135deg, #030712 0%, #111827 48%, #05070d 100%);
    }

    .hero-spotlight .hero-orb{
      right:35px;
      bottom:25px;
      width:240px;
      height:240px;
      border-radius:50%;
      background:var(--hero-radial);
      filter:blur(18px);
      opacity:.9;
    }

    .hero-spotlight .hero-orb::before{
      inset:28px;
      border-radius:50%;
      border:2px solid var(--hero-accent);
    }

    .hero-spotlight .hero-orb::after{
      display:none;
    }

    .hero-aurora{
      background:
        radial-gradient(circle at 82% 44%, var(--hero-radial), transparent 28%),
        linear-gradient(120deg, #05070d 0%, #111827 35%, rgba(255,255,255,.05) 50%, #07090f 100%);
    }

    .hero-aurora .hero-orb{
      right:-30px;
      bottom:-110px;
      width:720px;
      height:300px;
      border-radius:999px;
      background:linear-gradient(
        90deg,
        transparent,
        var(--hero-radial),
        rgba(255,255,255,.06),
        transparent
      );
      filter:blur(2px);
    }

    .hero-aurora .hero-orb::before{
      inset:38px;
      border-top:3px solid var(--hero-accent);
      border-left:none;
    }

    .hero-glass .hero-orb{
      right:38px;
      bottom:28px;
      width:280px;
      height:150px;
      border-radius:28px;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.16);
      backdrop-filter:blur(10px);
      box-shadow:0 0 35px var(--hero-radial);
      transform:rotate(-8deg);
    }

    .hero-glass .hero-orb::before{
      inset:18px;
      border-radius:22px;
      border:1px solid var(--hero-radial);
    }

    .hero-glass .hero-orb::after{
      right:28px;
      bottom:28px;
      width:80px;
      height:80px;
      background:var(--hero-radial);
    }

    .hero-rings .hero-orb,
    .hero-spotlight .hero-orb{
      animation:heroPulseAlt 7s ease-in-out infinite;
    }

    .hero-diagonal .hero-orb,
    .hero-aurora .hero-orb{
      animation:heroSlideAlt 8s ease-in-out infinite;
    }

    .hero-glass .hero-orb{
      animation:heroGlassFloat 6.5s ease-in-out infinite;
    }

    @keyframes heroEntrada{
      from{
        opacity: 0;
        transform: translateY(16px);
      }
      to{
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes heroFondoPremium{
      0%,100%{
        background-position:0% 50%;
      }
      50%{
        background-position:100% 50%;
      }
    }

    @keyframes lineaBrilloPremium{
      0%,100%{
        opacity:.35;
        transform:scaleX(.75);
        filter:blur(.2px);
      }
      50%{
        opacity:1;
        transform:scaleX(1.08);
        filter:blur(0);
      }
    }

    @keyframes orbGrandePremium{
      0%,100%{
        transform:translateY(0) scale(1);
        opacity:.75;
      }
      50%{
        transform:translateY(18px) scale(1.04);
        opacity:.95;
      }
    }

    @keyframes curvaPremium{
      0%,100%{
        transform:rotate(-10deg) translateY(0) translateX(0);
      }
      50%{
        transform:rotate(-10deg) translateY(-18px) translateX(-10px);
      }
    }

    @keyframes dotsFlotando{
      0%,100%{
        transform:translateY(0);
        opacity:.13;
      }
      50%{
        transform:translateY(-12px);
        opacity:.25;
      }
    }

    @keyframes marcaBrillo{
      0%,100%{
        opacity:.13;
        filter:drop-shadow(0 0 0 rgba(244,180,0,0));
      }
      50%{
        opacity:.28;
        filter:drop-shadow(0 0 16px var(--hero-glow));
      }
    }

    @keyframes tituloGlow{
      0%,100%{
        text-shadow:
          0 8px 24px rgba(0,0,0,.35),
          0 0 0 rgba(244,180,0,0);
      }
      50%{
        text-shadow:
          0 8px 24px rgba(0,0,0,.35),
          0 0 24px var(--hero-radial);
      }
    }

    @keyframes luzCruzando{
      0%{
        left:-45%;
        opacity:0;
      }
      20%{
        opacity:.75;
      }
      55%{
        opacity:.35;
      }
      100%{
        left:115%;
        opacity:0;
      }
    }

    @keyframes heroPulseAlt{
      0%,100%{
        transform:scale(1);
        opacity:.45;
      }
      50%{
        transform:scale(1.06);
        opacity:.75;
      }
    }

    @keyframes heroSlideAlt{
      0%,100%{
        transform:rotate(-18deg) translateX(0);
      }
      50%{
        transform:rotate(-18deg) translateX(-22px);
      }
    }

    @keyframes heroGlassFloat{
      0%,100%{
        transform:rotate(-8deg) translateY(0);
      }
      50%{
        transform:rotate(-8deg) translateY(-16px);
      }
    }

    .stats-inline{
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 10px;
    }

    .stat-chip{
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.74);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.86);
      box-shadow: 0 10px 24px rgba(15,23,42,0.05);
      transition: transform .16s ease, box-shadow .16s ease;
    }

    .stat-chip:hover{
      transform: translateY(-1px);
      box-shadow: 0 14px 28px rgba(15,23,42,0.08);
    }

    .stat-dot{
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--azul-2), #60a5fa);
      flex-shrink: 0;
      box-shadow: 0 0 0 4px rgba(37,99,235,0.08);
    }

    .stat-text{
      display: flex;
      align-items: baseline;
      gap: 6px;
      white-space: nowrap;
    }

    .stat-label{
      font-size: .82rem;
      color: var(--gris-texto);
      font-weight: 600;
    }

    .stat-value{
      font-size: .95rem;
      color: var(--oscuro-2);
      font-weight: 800;
      line-height: 1;
    }

    .section-head{
      margin: 28px 0 16px;
    }

    .section-title{
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--oscuro-2);
      margin-bottom: 4px;
    }

    .section-subtitle{
      color: var(--gris-texto);
      margin-bottom: 0;
    }

    .module-card{
      border: 1px solid rgba(255,255,255,0.88);
      border-radius: 24px;
      background: rgba(255,255,255,0.90);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 18px 38px rgba(31,41,55,0.06);
      transition: transform .18s ease, box-shadow .18s ease;
      height: 100%;
      overflow: hidden;
      position: relative;
    }

    .module-card:hover{
      transform: translateY(-4px);
      box-shadow: 0 22px 42px rgba(31,41,55,0.10);
    }

    .module-body{
      padding: 26px 24px 22px;
    }

    .module-icon{
      width: 60px;
      height: 60px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      background: linear-gradient(145deg, var(--gris-icono-1), var(--gris-icono-2));
      color: #475569;
      border: 1px solid #e5e7eb;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.82);
      margin-bottom: 16px;
    }

    .module-title{
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--oscuro-2);
      margin-bottom: 10px;
    }

    .module-text{
      color: var(--gris-texto);
      font-size: .98rem;
      line-height: 1.55;
      min-height: 70px;
    }

    .btn-soft{
      border: none;
      border-radius: 16px;
      padding: 11px 18px;
      font-weight: 700;
      background: linear-gradient(135deg, var(--amarillo), #e3a700);
      color: #1f2937;
      box-shadow: 0 10px 22px rgba(244,180,0,0.16);
      transition: all .18s ease;
    }

    .btn-soft:hover{
      transform: translateY(-1px);
      background: linear-gradient(135deg, var(--amarillo-suave), var(--amarillo));
      color: #111827;
    }

    @media (max-width: 991px){
      .brand-logo{
        width: 64px;
        height: 64px;
      }

      .hero-title{
        font-size: 1.85rem;
      }

      .hero-body{
        padding: 42px 26px 40px;
      }

      .hero-rings .hero-orb,
      .hero-diagonal .hero-orb,
      .hero-waves .hero-orb,
      .hero-spotlight .hero-orb,
      .hero-aurora .hero-orb,
      .hero-glass .hero-orb,
      .hero-orb{
        width:420px;
        height:240px;
        right:-170px;
        bottom:-90px;
        opacity:.7;
      }

      .hero-mark,
      .hero-dots{
        display: none;
      }

      .stats-inline{
        justify-content: flex-start;
      }

      .topbar .container{
        gap: 12px;
      }
    }
  </style>
</head>

<body>
  <%
    const usuarioActual = typeof usuario !== 'undefined' && usuario ? usuario : { nombre: 'Administrador' };

    const resumenActual = typeof resumen !== 'undefined' && resumen ? resumen : {
      productosTotales: 0,
      productosSinCategoria: 0,
      categoriasTotales: 0,
      adminsActivos: 0
    };

    const temaHero =
      typeof heroTheme !== 'undefined' && heroTheme
        ? heroTheme
        : {
            variant: 'curve',
            accent: '#f4b400',
            glow: 'rgba(244,180,0,.75)',
            radial: 'rgba(244,180,0,.22)'
          };
  %>

  <nav class="navbar navbar-expand-lg topbar shadow-sm">
    <div class="container">
      <div class="brand-wrap">
        <img src="/img/indemarc.png" alt="INDEMARC" class="brand-logo">
      </div>

      <div class="d-flex align-items-center gap-2">
        <span class="hello-text d-none d-md-inline">Hola, <%= usuarioActual.nombre %></span>
        <a href="/catalogo" class="btn btn-nav btn-sm">Ver catálogo</a>
        <a href="/logout" class="btn btn-nav btn-sm">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <div class="container dashboard-wrap">

    <div 
      class="hero-card hero-<%= temaHero.variant || 'curve' %>"
      style="
        --hero-accent:<%= temaHero.accent %>;
        --hero-glow:<%= temaHero.glow %>;
        --hero-radial:<%= temaHero.radial %>;
      "
    >
      <div class="hero-orb"></div>
      <div class="hero-dots"></div>
      <div class="hero-mark"></div>

      <div class="hero-body">
        <h1 class="hero-title">Bienvenido, <%= usuarioActual.nombre %></h1>
      </div>
    </div>

    <div class="stats-inline">
      <div class="stat-chip">
        <span class="stat-dot"></span>
        <div class="stat-text">
          <span class="stat-label">Productos</span>
          <span class="stat-value"><%= resumenActual.productosTotales %></span>
        </div>
      </div>

      <div class="stat-chip">
        <span class="stat-dot"></span>
        <div class="stat-text">
          <span class="stat-label">Sin categoría</span>
          <span class="stat-value"><%= resumenActual.productosSinCategoria %></span>
        </div>
      </div>

      <div class="stat-chip">
        <span class="stat-dot"></span>
        <div class="stat-text">
          <span class="stat-label">Categorías</span>
          <span class="stat-value"><%= resumenActual.categoriasTotales %></span>
        </div>
      </div>

      <div class="stat-chip">
        <span class="stat-dot"></span>
        <div class="stat-text">
          <span class="stat-label">Admins</span>
          <span class="stat-value"><%= resumenActual.adminsActivos %></span>
        </div>
      </div>
    </div>

    <div class="section-head">
      <h2 class="section-title">Accesos rápidos</h2>
    </div>

    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <div class="module-card">
          <div class="module-body">
            <div class="module-icon">📦</div>
            <div class="module-title">Productos</div>
            <div class="module-text">
              Crear, editar, eliminar y organizar los productos del catálogo.
            </div>
            <a href="/admin/productos" class="btn btn-soft">Gestionar</a>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-xl-3">
        <div class="module-card">
          <div class="module-body">
            <div class="module-icon">🗂️</div>
            <div class="module-title">Categorías</div>
            <div class="module-text">
              Organiza las categorías y clasifica mejor cada producto del sistema.
            </div>
            <a href="/admin/categorias" class="btn btn-soft">Gestionar</a>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-xl-3">
        <div class="module-card">
