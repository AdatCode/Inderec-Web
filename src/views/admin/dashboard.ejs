<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root{
      --amarillo: #f4b400;
      --amarillo-suave: #ffd65a;
      --gris-fondo: #eef2f6;
      --gris-texto: #667085;
      --gris-borde: #dbe2ea;
      --gris-icono-1: #f8fafc;
      --gris-icono-2: #eef2f7;
      --oscuro: #1f2937;
      --oscuro-2: #111827;
      --blanco: #ffffff;
      --azul-1: #0d0d0d;
      --azul-2: #2563eb;
    }

    *{
      box-sizing: border-box;
    }

    body{
      background:
        radial-gradient(circle at 10% 15%, rgba(244,180,0,0.08), transparent 18%),
        radial-gradient(circle at 90% 80%, rgba(255,255,255,0.65), transparent 16%),
        linear-gradient(135deg, #eef2f6, #f7f8fb, #eef1f5);
      min-height: 100vh;
      margin: 0;
      font-family: Arial, sans-serif;
      color: var(--oscuro);
    }

    .topbar{
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.96), rgba(0, 0, 0, 0.96));
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(160,174,192,0.18);
      box-shadow: 0 8px 20px rgba(4, 255, 25, 0.05);
    }

    .brand-wrap{
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-logo{
      width: 100px;
      height: 40px;
      object-fit: contain;
      display: block;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,.10));
    }

    .hello-text{
      
      color: #ffffff;
      font-size: .90rem;
      font-weight: 1000;
    
    }

    .btn-nav{
      border-radius: 999px;
      font-weight: 700;
      padding: 10px 18px;
      border: none;
      background: linear-gradient(135deg, var(--amarillo), #e7a900);
      color: #1f2937;
      box-shadow: 0 8px 18px rgba(244,180,0,0.18);
      transition: all .18s ease;
    }

    .btn-nav:hover{
      transform: translateY(-1px);
      background: linear-gradient(135deg, var(--amarillo-suave), var(--amarillo));
      color: #111827;
    }

    .dashboard-wrap{
      padding: 34px 0 46px;
    }

    .hero-card{
      border: 1px solid rgba(255,255,255,0.82);
      border-radius: 30px;
      background: linear-gradient(135deg, var(--azul-1), var(--azul-2));
      box-shadow: 0 24px 55px rgba(37,99,235,0.14);
      overflow: hidden;
      position: relative;
    }

    .hero-card::after{
      content: "";
      position: absolute;
      right: -36px;
      top: -18px;
      width: 170px;
      height: 170px;
      border-radius: 50%;
      background: rgba(255,255,255,0.08);
    }

    .hero-orb{
      position: absolute;
      right: 55px;
      bottom: -34px;
      width: 126px;
      height: 126px;
      border-radius: 50%;
      background: rgba(255,255,255,0.06);
    }

    .hero-body{
      padding: 44px 36px 42px;
      position: relative;
      z-index: 1;
    }

    .hero-title{
      font-size: 2.25rem;
      font-weight: 800;
      margin-bottom: 8px;
      color: white;
    }

    .hero-subtitle{
      color: rgba(255,255,255,0.88);
      font-size: 1rem;
      max-width: 720px;
      margin-bottom: 0;
    }

    .stats-inline{
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 10px;
    }

    .stat-chip{
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.74);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.86);
      box-shadow: 0 10px 24px rgba(15,23,42,0.05);
      transition: transform .16s ease, box-shadow .16s ease;
    }

    .stat-chip:hover{
      transform: translateY(-1px);
      box-shadow: 0 14px 28px rgba(15,23,42,0.08);
    }

    .stat-dot{
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--azul-2), #60a5fa);
      flex-shrink: 0;
      box-shadow: 0 0 0 4px rgba(37,99,235,0.08);
    }

    .stat-text{
      display: flex;
      align-items: baseline;
      gap: 6px;
      white-space: nowrap;
    }

    .stat-label{
      font-size: .82rem;
      color: var(--gris-texto);
      font-weight: 600;
    }

    .stat-value{
      font-size: .95rem;
      color: var(--oscuro-2);
      font-weight: 800;
      line-height: 1;
    }

    .section-head{
      margin: 28px 0 16px;
    }

    .section-title{
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--oscuro-2);
      margin-bottom: 4px;
    }

    .section-subtitle{
      color: var(--gris-texto);
      margin-bottom: 0;
    }

    .module-card{
      border: 1px solid rgba(255,255,255,0.88);
      border-radius: 24px;
      background: rgba(255,255,255,0.90);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 18px 38px rgba(31,41,55,0.06);
      transition: transform .18s ease, box-shadow .18s ease;
      height: 100%;
      overflow: hidden;
      position: relative;
    }

    .module-card:hover{
      transform: translateY(-4px);
      box-shadow: 0 22px 42px rgba(31,41,55,0.10);
    }

    .module-body{
      padding: 26px 24px 22px;
    }

    .module-icon{
      width: 60px;
      height: 60px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      background: linear-gradient(145deg, var(--gris-icono-1), var(--gris-icono-2));
      color: #475569;
      border: 1px solid #e5e7eb;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.82);
      margin-bottom: 16px;
    }

    .module-title{
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--oscuro-2);
      margin-bottom: 10px;
    }

    .module-text{
      color: var(--gris-texto);
      font-size: .98rem;
      line-height: 1.55;
      min-height: 70px;
    }

    .btn-soft{
      border: none;
      border-radius: 16px;
      padding: 11px 18px;
      font-weight: 700;
      background: linear-gradient(135deg, var(--amarillo), #e3a700);
      color: #1f2937;
      box-shadow: 0 10px 22px rgba(244,180,0,0.16);
      transition: all .18s ease;
    }

    .btn-soft:hover{
      transform: translateY(-1px);
      background: linear-gradient(135deg, var(--amarillo-suave), var(--amarillo));
      color: #111827;
    }

    @media (max-width: 991px){
      .brand-logo{
        width: 64px;
        height: 64px;
      }

      .hero-title{
        font-size: 1.85rem;
      }

      .stats-inline{
        justify-content: flex-start;
      }

      .topbar .container{
        gap: 12px;
      }
    }
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg topbar shadow-sm">
    <div class="container">
      <div class="brand-wrap">
        <img src="/img/indemarc.png" alt="INDEMARC" class="brand-logo">
      </div>

      <div class="d-flex align-items-center gap-2">
        <span class="hello-text d-none d-md-inline">Hola, <%= usuario.nombre %></span>
        <a href="/catalogo" class="btn btn-nav btn-sm">Ver catálogo</a>
        <a href="/logout" class="btn btn-nav btn-sm">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <div class="container dashboard-wrap">

    <div class="hero-card">
      <div class="hero-orb"></div>
      <div class="hero-body">
        <h1 class="hero-title">Bienvenido, <%= usuario.nombre %></h1>
      </div>
    </div>

    <div class="stats-inline">
      <div class="stat-chip">
        <span class="stat-dot"></span>
        <div class="stat-text">
          <span class="stat-label">Productos</span>
          <span class="stat-value"><%= resumen.productosTotales %></span>
        </div>
      </div>

      <div class="stat-chip">
        <span class="stat-dot"></span>
        <div class="stat-text">
          <span class="stat-label">Sin categoría</span>
          <span class="stat-value"><%= resumen.productosSinCategoria %></span>
        </div>
      </div>

      <div class="stat-chip">
        <span class="stat-dot"></span>
        <div class="stat-text">
          <span class="stat-label">Categorías</span>
          <span class="stat-value"><%= resumen.categoriasTotales %></span>
        </div>
      </div>

      <div class="stat-chip">
        <span class="stat-dot"></span>
        <div class="stat-text">
          <span class="stat-label">Admins</span>
          <span class="stat-value"><%= resumen.adminsActivos %></span>
        </div>
      </div>
    </div>

    <div class="section-head">
      <h2 class="section-title">Accesos rápidos</h2>

    </div>

    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <div class="module-card">
          <div class="module-body">
            <div class="module-icon">📦</div>
            <div class="module-title">Productos</div>
            <div class="module-text">
              Crear, editar, eliminar y organizar los productos del catálogo.
            </div>
            <a href="/admin/productos" class="btn btn-soft">Gestionar</a>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-xl-3">
        <div class="module-card">
          <div class="module-body">
            <div class="module-icon">🗂️</div>
            <div class="module-title">Categorías</div>
            <div class="module-text">
              Organiza las categorías y clasifica mejor cada producto del sistema.
            </div>
            <a href="/admin/categorias" class="btn btn-soft">Gestionar</a>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-xl-3">
        <div class="module-card">
          <div class="module-body">
            <div class="module-icon">👤</div>
            <div class="module-title">Administradores</div>
            <div class="module-text">
              Gestiona las cuentas con acceso administrativo al panel del sistema.
            </div>
            <a href="/admin/administradores" class="btn btn-soft">Gestionar</a>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-xl-3">
        <div class="module-card">
          <div class="module-body">
            <div class="module-icon">🛍️</div>
            <div class="module-title">Catálogo público</div>
            <div class="module-text">
              Visualizacion del catálogo.
            </div>
            <a href="/catalogo" class="btn btn-soft">Abrir</a>
          </div>
        </div>
      </div>
    </div>

  </div>

</body>
</html>