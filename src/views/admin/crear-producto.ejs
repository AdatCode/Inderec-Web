<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear producto</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --amarillo:#f4b400;
      --amarillo-suave:#ffd65a;
      --oscuro:#111827;
      --gris:#6b7280;
      --borde:#e5e7eb;
      --fondo:#f5f7fb;
    }

    body{
      background:
        radial-gradient(circle at 12% 12%, rgba(244,180,0,.08), transparent 18%),
        linear-gradient(135deg, #f8fafc, #eef2f7);
      min-height:100vh;
      font-family: Arial, sans-serif;
      color:var(--oscuro);
    }

    .topbar{
      background: linear-gradient(135deg, #111827, #1f2937);
      box-shadow: 0 8px 22px rgba(15,23,42,.14);
    }

    .navbar-brand{
      font-weight:800;
      letter-spacing:.2px;
    }

    .btn-nav{
      border-radius:999px;
      font-weight:700;
      padding:8px 16px;
    }

    .page-wrap{
      padding:42px 0 55px;
    }

    .form-card{
      max-width: 980px;
      margin: 0 auto;
      border:none;
      border-radius:24px;
      overflow:hidden;
      background:white;
      box-shadow:0 18px 45px rgba(15,23,42,.08);
      position:relative;
    }

    .form-card::before{
      content:"";
      position:absolute;
      top:0;
      left:0;
      right:0;
      height:6px;
      background:linear-gradient(90deg, var(--amarillo), var(--amarillo-suave));
    }

    .form-header{
      padding:34px 38px 18px;
      border-bottom:1px solid #f1f5f9;
    }

    .page-title{
      font-size:2rem;
      font-weight:800;
      margin:0 0 6px;
      color:#111827;
    }

    .page-subtitle{
      color:var(--gris);
      margin:0;
      font-size:.96rem;
    }

    .form-body{
      padding:28px 38px 34px;
    }

    .section-title{
      font-size:.95rem;
      font-weight:800;
      color:#374151;
      margin-bottom:16px;
      display:flex;
      align-items:center;
      gap:9px;
    }

    .section-title span{
      width:10px;
      height:10px;
      border-radius:50%;
      background:var(--amarillo);
      box-shadow:0 0 0 4px rgba(244,180,0,.14);
    }

    .section-box{
      background:#f8fafc;
      border:1px solid #e5e7eb;
      border-radius:18px;
      padding:20px;
      margin-bottom:18px;
    }

    .form-label{
      font-weight:700;
      color:#374151;
      margin-bottom:7px;
    }

    .form-control,
    .form-select{
      border-radius:14px;
      border:1px solid #dbe3ee;
      padding:12px 14px;
      background:#fff;
    }

    .form-control:focus,
    .form-select:focus{
      border-color:var(--amarillo);
      box-shadow:0 0 0 .22rem rgba(244,180,0,.12);
    }

    textarea.form-control{
      min-height:125px;
      resize:vertical;
    }

    .admin-note{
      margin-top:7px;
      font-size:.82rem;
      color:#7c5a00;
      font-weight:700;
    }

    .file-hint{
      color:var(--gris);
      font-size:.84rem;
      margin-top:6px;
    }

    .actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin-top:6px;
    }

    .btn-save{
      border:none;
      border-radius:14px;
      padding:12px 22px;
      font-weight:800;
      background:linear-gradient(135deg, var(--amarillo), #e3a700);
      color:#111827;
      box-shadow:0 10px 22px rgba(244,180,0,.18);
    }

    .btn-save:hover{
      background:linear-gradient(135deg, var(--amarillo-suave), var(--amarillo));
      color:#111827;
      transform:translateY(-1px);
    }

    .btn-cancel{
      border-radius:14px;
      padding:12px 22px;
      font-weight:700;
    }

    @media(max-width: 768px){
      .form-header,
      .form-body{
        padding-left:22px;
        padding-right:22px;
      }

      .page-title{
        font-size:1.65rem;
      }
    }
    /* ===== TOPBAR CREAR PRODUCTO ===== */

.topbar-admin-custom{
  background: linear-gradient(135deg, #0f172a 0%, #1f2937 45%, #0b1220 100%);
  padding: 14px 0;
  border-bottom: 1px solid rgba(255,255,255,.05);
}

.admin-topbar-inner{
  width: 100%;
  max-width: 1280px;   /* este valor controla que quede alineado con los cuadros de abajo */
  margin: 0 auto;
  padding: 0 34px;     /* ajusta esto si quieres mover un poquito */
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.brand-logo-wrap{
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  text-decoration: none;
  flex-shrink: 0;
}

.brand-logo-img{
  width: 165px;   /* aquí agrandas o achicas el logo */
  height: auto;
  display: block;
  object-fit: contain;
}

.topbar-actions{
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.topbar-yellow-btn{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 7px 22px;
  border-radius: 999px;
  background: linear-gradient(135deg, #f4b400, #ffd65a);
  color: #111827;
  font-size: .98rem;
  font-weight: 900;
  text-decoration: none;
  border: none;
  box-shadow: 0 12px 24px rgba(244,180,0,.28);
  transition: all .18s ease;
  white-space: nowrap;
}

.topbar-yellow-btn:hover{
  color: #111827;
  transform: translateY(-2px);
  background: linear-gradient(135deg, #ffd65a, #f4b400);
  box-shadow: 0 16px 32px rgba(244,180,0,.36);
}

.topbar-yellow-btn:active{
  transform: translateY(0);
}

/* ===== RESPONSIVE ===== */

@media (max-width: 991px){
  .admin-topbar-inner{
    padding: 0 20px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .brand-logo-wrap{
    justify-content: center;
  }

  .brand-logo-img{
    width: 145px;
  }

  .topbar-actions{
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 576px){
  .brand-logo-img{
    width: 130px;
  }

  .topbar-yellow-btn{
    padding: 10px 18px;
    font-size: .93rem;
  }
}
/* ===== TOPBAR CREAR PRODUCTO ALINEADO CON EL CUADRO ===== */

.topbar-producto{
  width:100%;
  height:118px;
  background:linear-gradient(135deg, #111827, #1f2937, #0f172a);
  border-bottom:1px solid rgba(255,255,255,.06);
  box-shadow:0 10px 26px rgba(15,23,42,.12);
  display:flex;
  align-items:center;
}

/* Este ancho debe quedar igual al cuadro blanco de abajo */
.topbar-producto-inner{
  width:100%;
  max-width:1050px;
  margin:0 auto;
  padding:0;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
}

/* LOGO alineado al borde izquierdo del cuadro */
.topbar-logo-link{
  display:flex;
  align-items:center;
  justify-content:flex-start;
  text-decoration:none;
  height:80px;
  padding:0;
  margin:0;
}

.topbar-logo-img{
  width:200px !important;
  height:auto !important;
  object-fit:contain !important;
  display:block !important;

  /* agranda visualmente el logo sin agrandar la barra */
  transform:scale(1.75) !important;
  transform-origin:left center !important;

  filter:drop-shadow(0 8px 16px rgba(0,0,0,.35)) !important;
}

/* BOTONES alineados al borde derecho del cuadro */
.topbar-producto-actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:14px;
}

.topbar-producto-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:7px 24px;
  border-radius:999px;
  background:linear-gradient(135deg, #f4b400, #ffd65a);
  color:#111827;
  font-size:1rem;
  font-weight:900;
  text-decoration:none;
  border:none;
  box-shadow:0 12px 26px rgba(244,180,0,.28);
  transition:all .18s ease;
  white-space:nowrap;
}

.topbar-producto-btn:hover{
  color:#111827;
  transform:translateY(-2px);
  background:linear-gradient(135deg, #ffd65a, #f4b400);
  box-shadow:0 16px 34px rgba(244,180,0,.36);
}

.topbar-producto-btn:active{
  transform:translateY(0);
}

/* Responsive */
@media(max-width:768px){
  .topbar-producto{
    height:auto;
    padding:14px 16px;
  }

  .topbar-producto-inner{
    max-width:100%;
    flex-direction:column;
    align-items:flex-start;
  }

  .topbar-logo-img{
    width:110px;
  }

  .topbar-producto-actions{
    width:100%;
    display:grid;
    grid-template-columns:1fr;
  }

  .topbar-producto-btn{
    width:100%;
  }
}
/* ===== AJUSTE TOPBAR CREAR PRODUCTO ===== */

/* Reduce la franja azul */
.topbar-producto{
  height:86px !important;
  min-height:86px !important;
  padding:0 !important;
}

/* Mantiene logo y botones alineados al cuadro */
.topbar-producto-inner{
  height:86px !important;
  min-height:86px !important;
  max-width:1225px !important;
  margin:0 auto !important;
  padding:0 !important;
  display:flex !important;
  align-items:center !important;
  justify-content:space-between !important;
}

/* Agranda el logo */
.topbar-logo-img{
  width:px !important;
  height:auto !important;
  object-fit:contain !important;
  display:block !important;
  transform:scale(1.35) !important;
  transform-origin:left center !important;
}

/* Opcional: botones un poquito más compactos */
.topbar-producto-btn{
  padding:10px 22px !important;
  font-size:.95rem !important;
}
/* ===== JUNTAR LOGO Y BOTONES DEL TOPBAR CREAR PRODUCTO ===== */

/* Hace que el logo y botones estén más cerca entre sí */
.topbar-producto-inner{
  max-width:106 0px !important;
  padding:0 !important;
}

/* Mueve el logo más a la derecha */
.topbar-logo-link{
  transform:translateX(35px) !important;
}

/* Mueve los botones más a la izquierda */
.topbar-producto-actions{
  transform:translateX(15px) !important;
}

/* Responsive: en celular no moverlos */
@media(max-width:768px){
  .topbar-producto-inner{
    max-width:100% !important;
    padding:0 16px !important;
  }

  .topbar-logo-link,
  .topbar-producto-actions{
    transform:none !important;
  }
}
/* ===== JUNTAR LOGO Y BOTONES DEL TOPBAR CREAR PRODUCTO ===== */

/* Hace que el logo y botones estén más cerca entre sí */
.topbar-producto-inner{
  max-width:1050px !important;
  padding:0 !important;
}

/* Mueve el logo más a la derecha */
.topbar-logo-link{
  transform:translateX(35px) !important;
}

/* Mueve los botones más a la izquierda */
.topbar-producto-actions{
  transform:translateX(-35px) !important;
}

/* Responsive: en celular no moverlos */
@media(max-width:768px){
  .topbar-producto-inner{
    max-width:100% !important;
    padding:0 16px !important;
  }

  .topbar-logo-link,
  .topbar-producto-actions{
    transform:none !important;
  }
}
/* ===== AJUSTE FINAL TOPBAR CREAR PRODUCTO ===== */

/* Mantiene la barra delgada */
.topbar-producto{
  height:86px !important;
  min-height:86px !important;
  padding:0 !important;
}

/* Mantiene el contenido alineado con el cuadro */
.topbar-producto-inner{
  max-width:965px !important;
  height:86px !important;
  min-height:86px !important;
  margin:0 auto !important;
  padding:0 !important;
  display:flex !important;
  align-items:center !important;
  justify-content:space-between !important;
}

/* MOVER LOGO MÁS A LA IZQUIERDA */
.topbar-logo-link{
  transform:translateX(-95px) !important;
}

/* Tamaño del logo */
.topbar-logo-img{
  width:165px !important;
  height:auto !important;
  object-fit:contain !important;
  display:block !important;
  transform:scale(1.25) !important;
  transform-origin:left center !important;
}

/* BOTONES MÁS PEQUEÑOS */
.topbar-producto-actions{
  gap:10px !important;
  transform:none !important;
}

.topbar-producto-btn{
  padding:8px 16px !important;
  font-size:.82rem !important;
  border-radius:999px !important;
  gap:6px !important;
  box-shadow:0 8px 18px rgba(244,180,0,.22) !important;
}

/* En celular se acomoda normal */
@media(max-width:768px){
  .topbar-producto{
    height:auto !important;
    min-height:auto !important;
    padding:14px 16px !important;
  }

  .topbar-producto-inner{
    max-width:100% !important;
    height:auto !important;
    min-height:auto !important;
    flex-direction:column !important;
    align-items:flex-start !important;
  }

  .topbar-logo-link{
    transform:none !important;
  }

  .topbar-logo-img{
    width:120px !important;
    transform:scale(1.1) !important;
  }

  .topbar-producto-actions{
    width:100% !important;
    display:grid !important;
    grid-template-columns:1fr !important;
  }

  .topbar-producto-btn{
    width:100% !important;
    padding:10px 14px !important;
    font-size:.88rem !important;
  }
}
/* Mover logo INDEMARC hacia la derecha */
.topbar-logo-link{
  transform:translateX(-65px) !important;
}

  </style>
</head>

<body>

  <nav class="topbar-producto">
  <div class="topbar-producto-inner">
    <a class="topbar-logo-link" href="/admin/dashboard">
      <img src="/img/indemarc.png" alt="INDEMARC" class="topbar-logo-img">
    </a>

    <div class="topbar-producto-actions">
      <a href="/admin/productos" class="topbar-producto-btn">
        📦 Productos
      </a>

      <a href="/admin/dashboard" class="topbar-producto-btn">
        📊 Dashboard
      </a>
    </div>
  </div>
</nav>

  <div class="container page-wrap">
    <div class="card form-card">

      <div class="form-header">
        <h2 class="page-title">Crear producto</h2>
        <p class="page-subtitle">
          Registra un producto para el catálogo. El precio será visible solo dentro del panel administrativo.
        </p>
      </div>

      <div class="form-body">

        <% if (typeof ok !== 'undefined' && ok) { %>
          <div class="alert alert-success rounded-4">
            Producto guardado correctamente.
          </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger rounded-4">
            <%= error %>
          </div>
        <% } %>

        <form action="/admin/productos/guardar" method="POST" enctype="multipart/form-data">

          <div class="section-box">
            <div class="section-title">
              <span></span>
              Información del producto
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input type="text" name="nombre" class="form-control" required>
              </div>

              <div class="col-md-3">
                <label class="form-label">Marca</label>
                <input type="text" name="marca" class="form-control">
              </div>

              <div class="col-md-3">
                <label class="form-label">Categoría</label>
                <select name="categoria_id" class="form-select" required>
                  <option value="">Seleccione</option>
                  <% if (typeof categorias !== 'undefined' && categorias.length > 0) { %>
                    <% categorias.forEach(categoria => { %>
                      <option value="<%= categoria.id %>"><%= categoria.nombre %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label">Descripción</label>
                <textarea name="descripcion" class="form-control" required></textarea>
              </div>
            </div>
          </div>

          <div class="section-box">
            <div class="section-title">
              <span></span>
              Inventario
            </div>

            <div class="row g-3">
              <div class="col-md-3">
                <label class="form-label">Stock</label>
                <input type="number" name="stock" class="form-control" min="0" required>
              </div>

              <div class="col-md-3">
                <label class="form-label">Precio</label>
                <input type="number" step="0.01" name="precio" class="form-control" min="0" required>
                <div class="admin-note">Solo admin</div>
              </div>

              <div class="col-md-6">
                <label class="form-label">Ubicación</label>
                <input type="text" name="ubicacion_rack" class="form-control" placeholder="Ej: A-03">
              </div>
            </div>
          </div>

          <div class="section-box">
            <div class="section-title">
              <span></span>
              Imagen
            </div>

            <label class="form-label">Imagen del producto</label>
            <input type="file" name="imagen" class="form-control" accept="image/*">
            <div class="file-hint">Formatos recomendados: JPG, PNG o WEBP.</div>
          </div>

          <div class="actions">
            <button type="submit" class="btn btn-save">Guardar producto</button>
            <a href="/admin/productos" class="btn btn-secondary btn-cancel">Cancelar</a>
          </div>

        </form>
      </div>
    </div>
  </div>

</body>
</html>