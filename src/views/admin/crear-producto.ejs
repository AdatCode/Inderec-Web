<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear producto</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --amarillo:#f4b400;
      --amarillo-suave:#ffd65a;
      --oscuro:#111827;
      --gris:#6b7280;
      --borde:#e5e7eb;
      --fondo:#f5f7fb;
    }

    body{
      background:
        radial-gradient(circle at 12% 12%, rgba(244,180,0,.08), transparent 18%),
        linear-gradient(135deg, #f8fafc, #eef2f7);
      min-height:100vh;
      font-family: Arial, sans-serif;
      color:var(--oscuro);
    }

    .topbar{
      background: linear-gradient(135deg, #111827, #1f2937);
      box-shadow: 0 8px 22px rgba(15,23,42,.14);
    }

    .navbar-brand{
      font-weight:800;
      letter-spacing:.2px;
    }

    .btn-nav{
      border-radius:999px;
      font-weight:700;
      padding:8px 16px;
    }

    .page-wrap{
      padding:42px 0 55px;
    }

    .form-card{
      max-width: 980px;
      margin: 0 auto;
      border:none;
      border-radius:24px;
      overflow:hidden;
      background:white;
      box-shadow:0 18px 45px rgba(15,23,42,.08);
      position:relative;
    }

    .form-card::before{
      content:"";
      position:absolute;
      top:0;
      left:0;
      right:0;
      height:6px;
      background:linear-gradient(90deg, var(--amarillo), var(--amarillo-suave));
    }

    .form-header{
      padding:34px 38px 18px;
      border-bottom:1px solid #f1f5f9;
    }

    .page-title{
      font-size:2rem;
      font-weight:800;
      margin:0 0 6px;
      color:#111827;
    }

    .page-subtitle{
      color:var(--gris);
      margin:0;
      font-size:.96rem;
    }

    .form-body{
      padding:28px 38px 34px;
    }

    .section-title{
      font-size:.95rem;
      font-weight:800;
      color:#374151;
      margin-bottom:16px;
      display:flex;
      align-items:center;
      gap:9px;
    }

    .section-title span{
      width:10px;
      height:10px;
      border-radius:50%;
      background:var(--amarillo);
      box-shadow:0 0 0 4px rgba(244,180,0,.14);
    }

    .section-box{
      background:#f8fafc;
      border:1px solid #e5e7eb;
      border-radius:18px;
      padding:20px;
      margin-bottom:18px;
    }

    .form-label{
      font-weight:700;
      color:#374151;
      margin-bottom:7px;
    }

    .form-control,
    .form-select{
      border-radius:14px;
      border:1px solid #dbe3ee;
      padding:12px 14px;
      background:#fff;
    }

    .form-control:focus,
    .form-select:focus{
      border-color:var(--amarillo);
      box-shadow:0 0 0 .22rem rgba(244,180,0,.12);
    }

    textarea.form-control{
      min-height:125px;
      resize:vertical;
    }

    .admin-note{
      margin-top:7px;
      font-size:.82rem;
      color:#7c5a00;
      font-weight:700;
    }

    .file-hint{
      color:var(--gris);
      font-size:.84rem;
      margin-top:6px;
    }

    .actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin-top:6px;
    }

    .btn-save{
      border:none;
      border-radius:14px;
      padding:12px 22px;
      font-weight:800;
      background:linear-gradient(135deg, var(--amarillo), #e3a700);
      color:#111827;
      box-shadow:0 10px 22px rgba(244,180,0,.18);
    }

    .btn-save:hover{
      background:linear-gradient(135deg, var(--amarillo-suave), var(--amarillo));
      color:#111827;
      transform:translateY(-1px);
    }

    .btn-cancel{
      border-radius:14px;
      padding:12px 22px;
      font-weight:700;
    }

    @media(max-width: 768px){
      .form-header,
      .form-body{
        padding-left:22px;
        padding-right:22px;
      }

      .page-title{
        font-size:1.65rem;
      }
    }
  </style>
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-dark topbar">
    <div class="container py-2">
      <a class="navbar-brand" href="/admin/dashboard">Sistema Catálogo</a>

      <div class="d-flex gap-2">
        <a href="/admin/productos" class="btn btn-outline-light btn-sm btn-nav">Productos</a>
        <a href="/admin/dashboard" class="btn btn-light btn-sm btn-nav">Dashboard</a>
      </div>
    </div>
  </nav>

  <div class="container page-wrap">
    <div class="card form-card">

      <div class="form-header">
        <h2 class="page-title">Crear producto</h2>
        <p class="page-subtitle">
          Registra un producto para el catálogo. El precio será visible solo dentro del panel administrativo.
        </p>
      </div>

      <div class="form-body">

        <% if (typeof ok !== 'undefined' && ok) { %>
          <div class="alert alert-success rounded-4">
            Producto guardado correctamente.
          </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger rounded-4">
            <%= error %>
          </div>
        <% } %>

        <form action="/admin/productos/guardar" method="POST" enctype="multipart/form-data">

          <div class="section-box">
            <div class="section-title">
              <span></span>
              Información del producto
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input type="text" name="nombre" class="form-control" required>
              </div>

              <div class="col-md-3">
                <label class="form-label">Marca</label>
                <input type="text" name="marca" class="form-control">
              </div>

              <div class="col-md-3">
                <label class="form-label">Categoría</label>
                <select name="categoria_id" class="form-select" required>
                  <option value="">Seleccione</option>
                  <% if (typeof categorias !== 'undefined' && categorias.length > 0) { %>
                    <% categorias.forEach(categoria => { %>
                      <option value="<%= categoria.id %>"><%= categoria.nombre %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label">Descripción</label>
                <textarea name="descripcion" class="form-control" required></textarea>
              </div>
            </div>
          </div>

          <div class="section-box">
            <div class="section-title">
              <span></span>
              Inventario
            </div>

            <div class="row g-3">
              <div class="col-md-3">
                <label class="form-label">Stock</label>
                <input type="number" name="stock" class="form-control" min="0" required>
              </div>

              <div class="col-md-3">
                <label class="form-label">Precio</label>
                <input type="number" step="0.01" name="precio" class="form-control" min="0" required>
                <div class="admin-note">Solo admin</div>
              </div>

              <div class="col-md-6">
                <label class="form-label">Ubicación</label>
                <input type="text" name="ubicacion_rack" class="form-control" placeholder="Ej: A-03">
              </div>
            </div>
          </div>

          <div class="section-box">
            <div class="section-title">
              <span></span>
              Imagen
            </div>

            <label class="form-label">Imagen del producto</label>
            <input type="file" name="imagen" class="form-control" accept="image/*">
            <div class="file-hint">Formatos recomendados: JPG, PNG o WEBP.</div>
          </div>

          <div class="actions">
            <button type="submit" class="btn btn-save">Guardar producto</button>
            <a href="/admin/productos" class="btn btn-secondary btn-cancel">Cancelar</a>
          </div>

        </form>
      </div>
    </div>
  </div>

</body>
</html>