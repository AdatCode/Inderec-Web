<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categorías</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{ background:#f5f7fb; }
    .topbar{ background:linear-gradient(135deg,#111827,#1f2937); }
    .hero-card{
      border:none;border-radius:22px;
      background:linear-gradient(135deg,#7c3aed,#8b5cf6);
      color:white;overflow:hidden;position:relative;
      box-shadow:0 18px 40px rgba(124,58,237,.18);
    }
    .hero-card::after{
      content:"";position:absolute;right:-35px;top:-35px;width:160px;height:160px;
      background:rgba(255,255,255,.08);border-radius:50%;
    }
    .hero-content{ position:relative; z-index:1; }
    .summary-pill{
      display:inline-flex;align-items:center;gap:8px;background:#fff;color:#111827;
      border-radius:999px;padding:10px 14px;font-size:.9rem;font-weight:600;
      box-shadow:0 8px 22px rgba(15,23,42,.06);
    }
    .table-card{ border:none;border-radius:20px;box-shadow:0 10px 28px rgba(15,23,42,.05); }
    .section-title{ font-weight:800;color:#111827; }
    .section-subtitle{ color:#6b7280;font-size:.95rem; }
    .categoria-chip{
      display:inline-flex;align-items:center;background:#eef2ff;color:#4338ca;
      border-radius:999px;padding:7px 12px;font-weight:600;font-size:.85rem;
    }
    .acciones{ min-width:180px; }
    .soft-num{
      display:inline-block;background:#f3f4f6;border:1px solid #e5e7eb;color:#374151;
      border-radius:999px;padding:4px 10px;font-size:.82rem;font-weight:600;min-width:42px;text-align:center;
    }
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark topbar shadow-sm">
    <div class="container">
      <span class="navbar-brand fw-bold">Panel de Administración</span>
      <div class="d-flex align-items-center gap-2">
        <a href="/admin/dashboard" class="btn btn-outline-light btn-sm">Dashboard</a>
        <a href="/admin/productos" class="btn btn-outline-light btn-sm">Productos</a>
        <a href="/logout" class="btn btn-light btn-sm">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <div class="container py-4 py-lg-5">

    <div class="card hero-card mb-4">
      <div class="card-body p-4 p-lg-5 hero-content">
        <div class="row g-3 align-items-center">
          <div class="col-lg-8">
            <h2 class="fw-bold mb-2">Gestión de categorías</h2>
            <p class="mb-0">Organiza tu catálogo creando categorías claras para clasificar mejor los productos.</p>
          </div>
          <div class="col-lg-4 text-lg-end">
            <a href="/admin/categorias/crear" class="btn btn-light fw-semibold">+ Nueva categoría</a>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <h3 class="section-title mb-1">Listado de categorías</h3>
        <p class="section-subtitle mb-0">Administra las categorías disponibles del sistema.</p>
      </div>
      <div class="summary-pill">Total categorías: <%= categorias.length %></div>
    </div>

    <div class="card table-card">
      <div class="card-body p-3 p-md-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>N°</th>
                <th>Categoría</th>
                <th class="acciones">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (categorias.length === 0) { %>
                <tr>
                  <td colspan="3" class="text-center py-4 text-muted">No hay categorías registradas</td>
                </tr>
              <% } %>

              <% categorias.forEach(categoria => { %>
                <tr>
                  <td><span class="soft-num"><%= categoria.orden ?? '-' %></span></td>
                  <td><span class="categoria-chip"><%= categoria.nombre %></span></td>
                  <td class="acciones">
                    <div class="d-flex flex-wrap gap-2">
                      <a href="/admin/categorias/editar/<%= categoria.id %>" class="btn btn-warning btn-sm">Editar</a>
                      <form action="/admin/categorias/eliminar/<%= categoria.id %>" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar esta categoría?')">
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

</body>
</html>