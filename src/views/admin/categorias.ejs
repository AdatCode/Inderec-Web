<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de categorías</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --dark:#111827;
      --dark-2:#1f2937;
      --bg:#f5f7fb;
      --border:#e5e7eb;
      --muted:#64748b;
      --purple:#7c3aed;
      --purple-2:#8b5cf6;
      --yellow:#f4b400;
      --red:#dc3545;
    }

    body{
      margin:0;
      background:#f5f7fb;
      color:#111827;
      font-family:Arial, sans-serif;
    }

    .topbar{
      background:#111827;
      box-shadow:0 6px 18px rgba(15,23,42,.14);
    }

    .topbar-inner{
      min-height:70px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
    }

    .brand-title{
      color:#ffffff;
      font-size:1.45rem;
      font-weight:900;
      text-decoration:none;
      letter-spacing:.2px;
    }

    .brand-title:hover{
      color:#ffffff;
    }

    .topbar-actions{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    .btn-nav{
      border-radius:8px;
      font-weight:700;
      padding:7px 13px;
    }

    .page-wrap{
      max-width:1120px;
      margin:0 auto;
      padding:38px 16px 60px;
    }

    .hero{
      position:relative;
      overflow:hidden;
      border-radius:28px;
      background:linear-gradient(135deg, #7c3aed, #8b5cf6);
      padding:42px 44px;
      color:#ffffff;
      box-shadow:0 18px 40px rgba(124,58,237,.20);
      margin-bottom:34px;
    }

    .hero::before{
      content:"";
      position:absolute;
      right:-70px;
      top:-80px;
      width:230px;
      height:230px;
      border-radius:50%;
      background:rgba(255,255,255,.14);
    }

    .hero::after{
      content:"";
      position:absolute;
      right:22px;
      bottom:-85px;
      width:160px;
      height:160px;
      border-radius:50%;
      background:rgba(255,255,255,.10);
    }

    .hero-content{
      position:relative;
      z-index:1;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:24px;
      flex-wrap:wrap;
    }

    .hero-title{
      font-size:2.15rem;
      font-weight:900;
      margin:0;
      line-height:1.1;
    }

    .hero-text{
      margin:12px 0 0;
      font-size:1.05rem;
      font-weight:600;
      color:rgba(255,255,255,.92);
    }

    .hero-btn{
      background:#ffffff;
      color:#111827;
      border:none;
      border-radius:12px;
      padding:12px 18px;
      font-weight:900;
      text-decoration:none;
      box-shadow:0 10px 22px rgba(15,23,42,.12);
      transition:.18s ease;
      white-space:nowrap;
    }

    .hero-btn:hover{
      color:#111827;
      transform:translateY(-1px);
      box-shadow:0 14px 26px rgba(15,23,42,.18);
    }

    .section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
      margin-bottom:22px;
    }

    .section-title{
      font-size:1.85rem;
      font-weight:900;
      margin:0 0 8px;
      color:#0f172a;
    }

    .section-subtitle{
      color:#64748b;
      font-weight:600;
      margin:0;
    }

    .total-pill{
      background:#ffffff;
      border:1px solid #edf1f7;
      border-radius:999px;
      padding:13px 20px;
      font-weight:900;
      color:#111827;
      box-shadow:0 12px 26px rgba(15,23,42,.06);
      white-space:nowrap;
    }

    .table-card{
      background:#ffffff;
      border:1px solid #edf1f7;
      border-radius:24px;
      box-shadow:0 16px 36px rgba(15,23,42,.07);
      padding:18px;
      overflow:hidden;
    }

    .table{
      margin:0;
      vertical-align:middle;
    }

    .table thead th{
      background:#f8fafc;
      color:#111827;
      font-weight:900;
      border-bottom:1px solid #dbe3ee;
      padding:14px 12px;
    }

    .table tbody td{
      padding:14px 12px;
      font-weight:700;
      color:#334155;
    }

    .numero-pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:42px;
      height:34px;
      border-radius:999px;
      background:#f8fafc;
      border:1px solid #e5e7eb;
      color:#475569;
      font-weight:900;
    }

    .categoria-chip{
      display:inline-flex;
      align-items:center;
      gap:8px;
      max-width:100%;
      background:#f5f3ff;
      border:1px solid #ddd6fe;
      color:#5b21b6;
      border-radius:999px;
      padding:9px 14px;
      font-weight:900;
    }

    .categoria-chip .icon{
      width:27px;
      height:27px;
      border-radius:50%;
      background:#ede9fe;
      border:1px solid #c4b5fd;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .actions{
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
    }

    .btn-edit{
      background:#f4b400;
      color:#111827;
      border:none;
      border-radius:10px;
      padding:8px 13px;
      font-weight:900;
      text-decoration:none;
    }

    .btn-edit:hover{
      background:#ffd45c;
      color:#111827;
      transform:translateY(-1px);
    }

    .btn-delete{
      background:#dc3545;
      color:#ffffff;
      border:none;
      border-radius:10px;
      padding:8px 13px;
      font-weight:900;
    }

    .btn-delete:hover{
      background:#bb2d3b;
      color:#ffffff;
      transform:translateY(-1px);
    }

    .empty-state{
      text-align:center;
      padding:40px 20px;
      color:#64748b;
      font-weight:800;
    }

    @media(max-width:768px){
      .topbar-inner{
        padding:14px 0;
        flex-direction:column;
        align-items:flex-start;
      }

      .brand-title{
        font-size:1.25rem;
      }

      .topbar-actions{
        width:100%;
        display:grid;
        grid-template-columns:1fr 1fr;
      }

      .topbar-actions .btn:last-child{
        grid-column:1 / -1;
      }

      .page-wrap{
        padding:26px 12px 42px;
      }

      .hero{
        padding:32px 24px;
        border-radius:22px;
      }

      .hero-title{
        font-size:1.7rem;
      }

      .hero-btn{
        width:100%;
        text-align:center;
      }

      .section-title{
        font-size:1.55rem;
      }

      .table-card{
        overflow-x:auto;
      }

      .table{
        min-width:680px;
      }
    }
  </style>
</head>

<body>

  <nav class="topbar">
    <div class="container topbar-inner">
      <a href="/admin/dashboard" class="brand-title">
        Panel de Administración
      </a>

      <div class="topbar-actions">
        <a href="/admin/dashboard" class="btn btn-outline-light btn-sm btn-nav">
          Dashboard
        </a>

        <a href="/admin/productos" class="btn btn-outline-light btn-sm btn-nav">
          Productos
        </a>

        <a href="/logout" class="btn btn-light btn-sm btn-nav">
          Cerrar sesión
        </a>
      </div>
    </div>
  </nav>

  <main class="page-wrap">

    <section class="hero">
      <div class="hero-content">
        <div>
          <h1 class="hero-title">Gestión de categorías</h1>
          <p class="hero-text">
            Organiza tu catálogo creando categorías claras para clasificar mejor los productos.
          </p>
        </div>

        <a href="/admin/categorias/crear" class="hero-btn">
          + Nueva categoría
        </a>
      </div>
    </section>

    <section>
      <div class="section-head">
        <div>
          <h2 class="section-title">Listado de categorías</h2>
          <p class="section-subtitle">
            Administra las categorías disponibles del sistema.
          </p>
        </div>

        <div class="total-pill">
          Total categorías: <%= categorias.length %>
        </div>
      </div>

      <div class="table-card">
        <% if (categorias.length === 0) { %>

          <div class="empty-state">
            No hay categorías registradas todavía.
          </div>

        <% } else { %>

          <table class="table">
            <thead>
              <tr>
                <th style="width:110px;">N°</th>
                <th>Categoría</th>
                <th style="width:260px;">Acciones</th>
              </tr>
            </thead>

            <tbody>
              <% categorias.forEach((categoria, index) => { %>
                <% const categoriaId = categoria.id || categoria.id_categoria; %>

                <tr>
                  <td>
                    <span class="numero-pill">
                      <%= index + 1 %>
                    </span>
                  </td>

                  <td>
                    <span class="categoria-chip">
                      <span class="icon">🗂️</span>
                      <span><%= categoria.nombre %></span>
                    </span>
                  </td>

                  <td>
                    <div class="actions">
                      <a 
                        href="/admin/categorias/editar/<%= categoriaId %>" 
                        class="btn-edit"
                      >
                        Editar
                      </a>

                      <form 
                        action="/admin/categorias/eliminar/<%= categoriaId %>" 
                        method="POST" 
                        style="display:inline;"
                        onsubmit="return confirm('¿Seguro que deseas eliminar esta categoría?');"
                      >
                        <button type="submit" class="btn-delete">
                          Eliminar
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>

        <% } %>
      </div>
    </section>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>