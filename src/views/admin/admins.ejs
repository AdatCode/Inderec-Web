<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Administradores</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{
      background: #f5f7fb;
    }

    .topbar{
      background: linear-gradient(135deg, #111827, #1f2937);
    }

    .hero-card{
      border: none;
      border-radius: 22px;
      background: linear-gradient(135deg, #0f766e, #14b8a6);
      color: white;
      overflow: hidden;
      position: relative;
      box-shadow: 0 18px 40px rgba(20, 184, 166, 0.18);
    }

    .hero-card::after{
      content: "";
      position: absolute;
      right: -35px;
      top: -35px;
      width: 160px;
      height: 160px;
      background: rgba(255,255,255,0.08);
      border-radius: 50%;
    }

    .hero-card::before{
      content: "";
      position: absolute;
      right: 25px;
      bottom: -45px;
      width: 120px;
      height: 120px;
      background: rgba(255,255,255,0.06);
      border-radius: 50%;
    }

    .hero-content{
      position: relative;
      z-index: 1;
    }

    .summary-pill{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #ffffff;
      color: #111827;
      border-radius: 999px;
      padding: 10px 14px;
      font-size: .9rem;
      font-weight: 600;
      box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
    }

    .table-card{
      border: none;
      border-radius: 20px;
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
    }

    .section-title{
      font-weight: 800;
      color: #111827;
    }

    .section-subtitle{
      color: #6b7280;
      font-size: .95rem;
    }

    .soft-id{
      display: inline-block;
      background: #f3f4f6;
      border: 1px solid #e5e7eb;
      color: #374151;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: .82rem;
      font-weight: 600;
    }

    .admin-chip{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #ecfeff;
      color: #0f766e;
      border-radius: 999px;
      padding: 7px 12px;
      font-weight: 700;
      font-size: .85rem;
    }

    .yo-badge{
      display: inline-block;
      margin-left: 8px;
      background: #dbeafe;
      color: #1d4ed8;
      border-radius: 999px;
      padding: 4px 8px;
      font-size: .75rem;
      font-weight: 700;
    }

    .correo-cell{
      color: #374151;
      font-weight: 500;
    }

    .acciones{
      min-width: 230px;
    }

    .table thead th{
      white-space: nowrap;
      vertical-align: middle;
      border-bottom: 0;
    }

    .table td{
      vertical-align: middle;
    }

    .sin-acciones{
      color: #6b7280;
      font-weight: 600;
    }
    /* ===== BOTONES SUPERIORES ADMINISTRADORES ===== */

.admin-top-actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:10px;
  flex-wrap:wrap;
}

.admin-nav-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  padding:7px 18px;
  border-radius:999px;
  background:linear-gradient(135deg, #f4b400, #ffd65a);
  color:#111827;
  font-size:.92rem;
  font-weight:900;
  text-decoration:none;
  border:none;
  box-shadow:0 10px 22px rgba(244,180,0,.24);
  transition:all .18s ease;
  white-space:nowrap;
}

.admin-nav-btn:hover{
  color:#111827;
  transform:translateY(-2px);
  background:linear-gradient(135deg, #ffd65a, #f4b400);
  box-shadow:0 14px 30px rgba(244,180,0,.34);
}

.admin-nav-btn:active{
  transform:translateY(0);
}

@media(max-width:768px){
  .admin-top-actions{
    width:100%;
    display:grid;
    grid-template-columns:1fr;
    justify-content:flex-start;
  }

  .admin-nav-btn{
    width:100%;
  }
}
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark topbar shadow-sm">
    <div class="container">
      <span class="navbar-brand fw-bold">Panel de Administración</span>

      <div class="admin-top-actions">
  <a href="/admin/dashboard" class="admin-nav-btn">
    📊 Dashboard
  </a>

  <a href="/catalogo" class="admin-nav-btn">
    🛍️ Ver catálogo
  </a>

  <a href="/logout" class="admin-nav-btn">
    🔒 Cerrar sesión
  </a>
</div>
    </div>
  </nav>

  <div class="container py-4 py-lg-5">

    <div class="card hero-card mb-4">
      <div class="card-body p-4 p-lg-5 hero-content">
        <div class="row g-3 align-items-center">
          <div class="col-lg-8">
            <h2 class="fw-bold mb-2">Gestión de administradores</h2>
            <p class="mb-0">
              Crea cuentas admin, actívalas, desactívalas o elimínalas de forma segura.
            </p>
          </div>

          <div class="col-lg-4 text-lg-end">
            <a href="/admin/administradores/crear" class="btn btn-light fw-semibold">
              + Nuevo admin
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <h3 class="section-title mb-1">Listado de administradores</h3>
        <p class="section-subtitle mb-0">Administra las cuentas con acceso al panel.</p>
      </div>

      <div class="summary-pill">
        Total administradores: <%= admins.length %>
      </div>
    </div>

    <div class="card table-card">
      <div class="card-body p-3 p-md-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>Administrador</th>
                <th>Correo</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th class="acciones">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (admins.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">
                    No hay administradores registrados
                  </td>
                </tr>
              <% } %>

              <% admins.forEach(admin => { %>
                <tr>
                  <td>
                    <span class="soft-id">#<%= admin.id %></span>
                  </td>

                  <td>
                    <span class="admin-chip"><%= admin.nombre %></span>
                    <% if (usuario && Number(usuario.id) === Number(admin.id)) { %>
                      <span class="yo-badge">Tú</span>
                    <% } %>
                  </td>

                  <td class="correo-cell"><%= admin.email %></td>

                  <td>
                    <% if (admin.estado === 'activo') { %>
                      <span class="badge text-bg-success">Activo</span>
                    <% } else { %>
                      <span class="badge text-bg-secondary">Inactivo</span>
                    <% } %>
                  </td>

                  <td><%= new Date(admin.created_at).toLocaleDateString('es-EC') %></td>

                  <td class="acciones">
                    <div class="d-flex flex-wrap gap-2">
                      <% if (usuario && Number(usuario.id) !== Number(admin.id)) { %>
                        <form action="/admin/administradores/estado/<%= admin.id %>" method="POST" class="d-inline">
                          <% if (admin.estado === 'activo') { %>
                            <button type="submit" class="btn btn-warning btn-sm">Desactivar</button>
                          <% } else { %>
                            <button type="submit" class="btn btn-success btn-sm">Activar</button>
                          <% } %>
                        </form>

                        <form action="/admin/administradores/eliminar/<%= admin.id %>" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este administrador?')">
                          <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                      <% } else { %>
                        <span class="sin-acciones">Sin acciones</span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

</body>
</html>