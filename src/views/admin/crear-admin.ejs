<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear administrador</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{
      background: #f5f7fb;
    }

    .topbar{
      background: linear-gradient(135deg, #111827, #1f2937);
    }

    .hero-card{
      border: none;
      border-radius: 22px;
      background: linear-gradient(135deg, #0f766e, #14b8a6);
      color: white;
      overflow: hidden;
      position: relative;
      box-shadow: 0 18px 40px rgba(20, 184, 166, 0.18);
    }

    .hero-card::after{
      content: "";
      position: absolute;
      right: -35px;
      top: -35px;
      width: 160px;
      height: 160px;
      background: rgba(255,255,255,0.08);
      border-radius: 50%;
    }

    .hero-card::before{
      content: "";
      position: absolute;
      right: 25px;
      bottom: -45px;
      width: 120px;
      height: 120px;
      background: rgba(255,255,255,0.06);
      border-radius: 50%;
    }

    .hero-content{
      position: relative;
      z-index: 1;
    }

    .form-card{
      border: none;
      border-radius: 20px;
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
    }

    .section-title{
      font-weight: 800;
      color: #111827;
    }

    .section-subtitle{
      color: #6b7280;
      font-size: .95rem;
    }

    .form-label{
      font-weight: 600;
      color: #374151;
      margin-bottom: 6px;
    }

    .form-control{
      border-radius: 12px;
      border: 1px solid #dbe1ea;
      padding-top: .68rem;
      padding-bottom: .68rem;
    }

    .form-control:focus{
      border-color: #14b8a6;
      box-shadow: 0 0 0 .2rem rgba(20, 184, 166, 0.12);
    }

    .hint{
      font-size: .82rem;
      color: #6b7280;
      margin-top: 5px;
    }
    /* ===== BOTONES SUPERIORES CREAR ADMIN ===== */

.admin-top-actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:10px;
  flex-wrap:wrap;
}

.admin-nav-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  padding:7px 18px;
  border-radius:999px;
  background:linear-gradient(135deg, #f4b400, #ffd65a);
  color:#111827;
  font-size:.92rem;
  font-weight:900;
  text-decoration:none;
  border:none;
  box-shadow:0 10px 22px rgba(244,180,0,.24);
  transition:all .18s ease;
  white-space:nowrap;
}

.admin-nav-btn:hover{
  color:#111827;
  transform:translateY(-2px);
  background:linear-gradient(135deg, #ffd65a, #f4b400);
  box-shadow:0 14px 30px rgba(244,180,0,.34);
}

.admin-nav-btn:active{
  transform:translateY(0);
}

/* ===== BOTÓN VOLVER DEL BANNER ===== */

.btn-back-admin{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:7px 18px;
  border-radius:12px;
  background:#ffffff;
  color:#111827;
  font-weight:900;
  text-decoration:none;
  border:none;
  box-shadow:0 12px 24px rgba(15,23,42,.10);
  transition:all .18s ease;
}

.btn-back-admin:hover{
  color:#111827;
  transform:translateY(-2px);
  background:linear-gradient(135deg, #f4b400, #ffd65a);
  box-shadow:0 16px 30px rgba(244,180,0,.26);
}

/* ===== BOTONES DEL FORMULARIO ===== */

.form-actions-admin{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
  margin-top:22px;
}

.btn-save-admin{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:7px 22px;
  border-radius:14px;
  border:none;
  background:linear-gradient(135deg, #f4b400, #ffd65a);
  color:#111827;
  font-weight:900;
  font-size:.98rem;
  text-decoration:none;
  box-shadow:0 12px 26px rgba(244,180,0,.26);
  transition:all .18s ease;
}

.btn-save-admin:hover{
  transform:translateY(-2px);
  background:linear-gradient(135deg, #ffd65a, #f4b400);
  box-shadow:0 16px 34px rgba(244,180,0,.34);
}

.btn-cancel-admin{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:7px 20px;
  border-radius:14px;
  border:none;
  background:#6b7280;
  color:#ffffff;
  font-weight:900;
  font-size:.98rem;
  text-decoration:none;
  box-shadow:0 10px 22px rgba(15,23,42,.14);
  transition:all .18s ease;
}

.btn-cancel-admin:hover{
  color:#ffffff;
  transform:translateY(-2px);
  background:#4b5563;
  box-shadow:0 14px 28px rgba(15,23,42,.20);
}

@media(max-width:768px){
  .admin-top-actions{
    width:100%;
    display:grid;
    grid-template-columns:1fr;
    justify-content:flex-start;
  }

  .admin-nav-btn,
  .btn-back-admin,
  .btn-save-admin,
  .btn-cancel-admin{
    width:100%;
  }

  .form-actions-admin{
    display:grid;
    grid-template-columns:1fr;
  }
}
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark topbar shadow-sm">
    <div class="container">
      <span class="navbar-brand fw-bold">Panel de Administración</span>

      <div class="admin-top-actions">
  <a href="/admin/dashboard" class="admin-nav-btn">
    📊 Dashboard
  </a>

  <a href="/admin/administradores" class="admin-nav-btn">
    👤 Administradores
  </a>

  <a href="/logout" class="admin-nav-btn">
    🔒 Cerrar sesión
  </a>
</div>
    </div>
  </nav>

  <div class="container py-4 py-lg-5">

    <div class="card hero-card mb-4">
      <div class="card-body p-4 p-lg-5 hero-content">
        <div class="row g-3 align-items-center">
          <div class="col-lg-8">
            <h2 class="fw-bold mb-2">Crear administrador</h2>
            <p class="mb-0">
              Registra una nueva cuenta con acceso al panel administrativo del sistema.
            </p>
          </div>

          <div class="col-lg-4 text-lg-end">
            <a href="/admin/administradores" class="btn btn-light fw-semibold">
              Volver a administradores
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-4">
      <h3 class="section-title mb-1">Formulario de registro</h3>
      <p class="section-subtitle mb-0">Completa los datos de la nueva cuenta administradora.</p>
    </div>

    <div class="card form-card">
      <div class="card-body p-4 p-lg-5">

        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="/admin/administradores/guardar" method="POST">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Nombre</label>
              <input type="text" name="nombre" class="form-control" placeholder="Ej: María Pérez" required>
            </div>

            <div class="col-md-6">
              <label class="form-label">Correo</label>
              <input type="email" name="email" class="form-control" placeholder="correo@ejemplo.com" required>
            </div>

            <div class="col-md-6">
              <label class="form-label">Contraseña</label>
              <input type="password" name="password" class="form-control" required>
              <div class="hint">Usa una contraseña segura para el nuevo administrador.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Confirmar contraseña</label>
              <input type="password" name="confirmar_password" class="form-control" required>
            </div>
          </div>

          <div class="form-actions-admin">
  <button type="submit" class="btn-save-admin">
    💾 Guardar administrador
  </button>

  <a href="/admin/administradores" class="btn-cancel-admin">
    Cancelar
  </a>
</div>
        </form>

      </div>
    </div>

  </div>

</body>
</html>