<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear categoría</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{
      background:#f5f7fb;
    }
    .topbar{
      background:linear-gradient(135deg,#111827,#1f2937);
    }
    .form-card{
      border:none;
      border-radius:20px;
      box-shadow:0 10px 28px rgba(15,23,42,.06);
    }
    .form-label{
      font-weight:600;
      color:#374151;
      margin-bottom:6px;
    }
    .form-control{
      border-radius:12px;
      border:1px solid #dbe1ea;
      padding-top:.62rem;
      padding-bottom:.62rem;
    }
    .form-control:focus{
      border-color:#7c3aed;
      box-shadow:0 0 0 .2rem rgba(124,58,237,.12);
    }
    .numero-box{
      max-width:120px;
    }
    .numero-box .form-control{
      text-align:center;
      font-weight:700;
    }
  </style>
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark topbar">
    <div class="container">
      <a href="/admin/dashboard" class="navbar-brand">Panel Admin</a>
      <div class="d-flex gap-2">
        <a href="/admin/categorias" class="btn btn-outline-light btn-sm">Volver</a>
        <a href="/logout" class="btn btn-light btn-sm">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card form-card">
          <div class="card-body p-4">
            <h3 class="mb-4 fw-bold">Crear categoría</h3>

            <% if (error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form action="/admin/categorias/guardar" method="POST">
              <div class="mb-3 numero-box">
                <label class="form-label">N°</label>
                <input type="number" name="orden" class="form-control" min="1" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input type="text" name="nombre" class="form-control" required>
              </div>

              <button type="submit" class="btn btn-primary">Guardar categoría</button>
              <a href="/admin/categorias" class="btn btn-secondary">Cancelar</a>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

</body>
</html>