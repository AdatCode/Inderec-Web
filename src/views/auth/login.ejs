<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Administrador | INDEMARC</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --amarillo: #f4c542;
      --amarillo-fuerte: #e6b800;
      --gris-borde: #d8dde6;
      --gris-texto: #667085;
      --gris-oscuro: #232a34;
      --blanco: #ffffff;
      --sombra: 0 20px 45px rgba(35, 42, 52, 0.12);
    }

    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background:
        radial-gradient(circle at top left, rgba(244, 197, 66, 0.14), transparent 22%),
        radial-gradient(circle at bottom right, rgba(190, 195, 203, 0.16), transparent 28%),
        linear-gradient(135deg, #f7f8fa 0%, #eceff3 100%);
      padding: 24px;
    }

    .login-wrapper {
      width: 100%;
      max-width: 430px;
    }

    .login-card {
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.85);
      border-radius: 28px;
      box-shadow: var(--sombra);
      padding: 24px 30px 28px;
      overflow: hidden;
      animation: fadeUp .35s ease;
      position: relative;
    }

    .login-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 6px;
      background: linear-gradient(90deg, #f4c542 0%, #e6b800 100%);
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 20px;
      padding-top: 6px;
    }

    .brand-logo {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 2px;
    }

    .brand-logo img {
      width: 600px;
      max-width: 125%;
      height: auto;
      object-fit: contain;
      display: block;
    }

    .brand h1 {
      font-size: 1.9rem;
      font-weight: 900;
      color: var(--gris-oscuro);
      letter-spacing: 0.3px;
      line-height: 1.05;
      margin-bottom: 8px;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px;
      border-radius: 999px;
      background: rgba(244, 197, 66, 0.12);
      color: #8a6500;
      font-size: 0.9rem;
      font-weight: 700;
      border: 1px solid rgba(230, 184, 0, 0.18);
    }

    .tag::before {
      content: "";
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--amarillo-fuerte);
    }

    .alert {
      padding: 12px 14px;
      border-radius: 14px;
      font-size: .92rem;
      margin-bottom: 16px;
      font-weight: 600;
    }

    .alert-error {
      background: #fff1f1;
      color: #b42318;
      border: 1px solid #f3c7c7;
    }

    .alert-success {
      background: #eefbf3;
      color: #067647;
      border: 1px solid #b7e4c7;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      margin-bottom: 9px;
      font-size: 1rem;
      font-weight: 800;
      color: var(--gris-oscuro);
    }

    .input-wrap {
      position: relative;
    }

    .input-wrap input {
      width: 100%;
      height: 58px;
      border: 1px solid var(--gris-borde);
      border-radius: 18px;
      padding: 0 54px 0 18px;
      font-size: 1rem;
      outline: none;
      background: rgba(255, 255, 255, 0.98);
      transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
      color: var(--gris-oscuro);
    }

    .input-wrap input::placeholder {
      color: #8c8f96;
    }

    .input-wrap input:focus {
      border-color: var(--amarillo-fuerte);
      box-shadow: 0 0 0 4px rgba(244, 197, 66, 0.12);
      background: var(--blanco);
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border: none;
      background: transparent;
      cursor: pointer;
      color: #7f8694;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .2s ease, color .2s ease;
    }

    .toggle-password:hover {
      background: rgba(244, 197, 66, 0.10);
      color: #5d6470;
    }

    .toggle-password svg {
      width: 21px;
      height: 21px;
      stroke: currentColor;
    }

    .btn-login {
      width: 100%;
      height: 58px;
      border: none;
      border-radius: 18px;
      background: linear-gradient(135deg, #f4c542 0%, #e6b800 100%);
      color: #201a08;
      font-size: 1.03rem;
      font-weight: 900;
      letter-spacing: .2px;
      cursor: pointer;
      transition: transform .2s ease, box-shadow .2s ease;
      margin-top: 6px;
      box-shadow: 0 12px 24px rgba(244, 197, 66, 0.24);
    }

    .btn-login:hover {
      transform: translateY(-1px);
      box-shadow: 0 16px 28px rgba(244, 197, 66, 0.30);
    }

    .btn-login:active {
      transform: scale(.99);
    }

    .footer-text {
      margin-top: 18px;
      text-align: center;
      font-size: .89rem;
      color: var(--gris-texto);
      line-height: 1.55;
    }

    .footer-text strong {
      color: var(--gris-oscuro);
    }

    @media (max-width: 480px) {
      .login-card {
        padding: 22px 20px 22px;
        border-radius: 24px;
      }

      .brand-logo img {
        width: 185px;
      }

      .brand h1 {
        font-size: 1.6rem;
      }

      .input-wrap input {
        height: 54px;
        border-radius: 16px;
      }

      .btn-login {
        height: 54px;
        border-radius: 16px;
      }
    }
  </style>
</head>
<body>
  <div class="login-wrapper">
    <div class="login-card">
      <div class="brand">
        <div class="brand-logo">
          <img src="/img/indemarc.png" alt="Logo INDEMARC">
        </div>

      
        <div class="tag">Acceso Administrativo</div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="email">Correo electrónico</label>
          <div class="input-wrap">
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Ingresa tu correo"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="password">Contraseña</label>
          <div class="input-wrap">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Ingresa tu contraseña"
              required
            />
            <button
              type="button"
              class="toggle-password"
              onclick="togglePassword()"
              aria-label="Mostrar contraseña"
              id="togglePasswordBtn"
            >
              <svg id="eyeOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>

              <svg id="eyeClosed" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" style="display: none;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.584 10.587a2 2 0 102.828 2.829" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.878 5.098A10.45 10.45 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.526 10.526 0 01-4.293 5.411M6.228 6.228A10.45 10.45 0 002.458 12c1.274 4.057 5.064 7 9.542 7a10.45 10.45 0 005.772-1.772" />
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-login">
          Ingresar al sistema
        </button>
      </form>

      
    </div>
  </div>

  <script>
    function togglePassword() {
      const input = document.getElementById('password');
      const eyeOpen = document.getElementById('eyeOpen');
      const eyeClosed = document.getElementById('eyeClosed');
      const button = document.getElementById('togglePasswordBtn');

      if (input.type === 'password') {
        input.type = 'text';
        eyeOpen.style.display = 'none';
        eyeClosed.style.display = 'block';
        button.setAttribute('aria-label', 'Ocultar contraseña');
      } else {
        input.type = 'password';
        eyeOpen.style.display = 'block';
        eyeClosed.style.display = 'none';
        button.setAttribute('aria-label', 'Mostrar contraseña');
      }
    }
  </script>
</body>
</html>