<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= producto.nombre %> | Detalle</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --oscuro:#111827;
      --gris:#64748b;
      --borde:#e5e7eb;
      --fondo:#f5f7fb;
      --amarillo:#f4b400;
      --verde:#16a34a;
    }

    body{
      background:#f5f7fb;
      color:#111827;
      font-family:Arial, sans-serif;
    }

    .topbar{
      background:#1f2429;
      box-shadow:0 6px 18px rgba(15,23,42,.12);
    }

    .navbar-brand{
      font-weight:800;
      letter-spacing:.2px;
    }

    .btn-nav{
      border-radius:8px;
      font-weight:700;
    }

    .page-wrap{
      padding:28px 0 60px;
    }

    .btn-volver{
      border-radius:12px;
      padding:9px 15px;
      font-weight:800;
      color:#475569;
      background:#ffffff;
      border:1px solid #dbe3ee;
      box-shadow:0 8px 18px rgba(15,23,42,.04);
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      gap:8px;
      transition:.18s ease;
      margin-bottom:22px;
    }

    .btn-volver:hover{
      color:#111827;
      transform:translateY(-1px);
      box-shadow:0 12px 24px rgba(15,23,42,.08);
    }

    .detalle-card{
      background:#ffffff;
      border:1px solid #edf1f7;
      border-radius:26px;
      box-shadow:0 18px 42px rgba(15,23,42,.08);
      overflow:hidden;
    }

    .detalle-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:0;
    }

    .detalle-img-section{
      padding:28px;
      background:linear-gradient(135deg, #ffffff, #f8fafc);
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .detalle-img-box{
      width:100%;
      height:420px;
      border-radius:24px;
      background:#ffffff;
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      box-shadow:inset 0 0 0 1px #eef2f7;
    }

    .detalle-img{
      width:100%;
      height:100%;
      object-fit:contain;
      object-position:center;
      transform:scale(1.02);
    }

    .sin-img{
      width:100%;
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      color:#94a3b8;
      font-weight:800;
      font-size:1.1rem;
    }

    .detalle-info{
      padding:34px 34px 30px;
    }

    .detalle-title{
      font-size:2rem;
      font-weight:800;
      letter-spacing:.5px;
      line-height:1.15;
      color:#111827;
      margin-bottom:16px;
    }

    .info-tags{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-bottom:20px;
    }

    .info-tag{
      display:inline-flex;
      align-items:center;
      gap:8px;
      border-radius:999px;
      padding:8px 12px;
      background:#f8fafc;
      border:1px solid #e5e7eb;
      color:#475569;
      font-weight:800;
      font-size:.9rem;
    }

    .info-tag .icon{
      width:26px;
      height:26px;
      border-radius:50%;
      background:#eef2f7;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:.85rem;
    }

    .stock-card{
      display:inline-flex;
      align-items:center;
      gap:10px;
      border-radius:16px;
      padding:10px 14px;
      background:#f0fdf4;
      border:1px solid #bbf7d0;
      color:#166534;
      font-weight:900;
      margin-bottom:20px;
    }

    .stock-card .icon{
      width:34px;
      height:34px;
      border-radius:12px;
      background:#dcfce7;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .divider{
      border:none;
      height:1px;
      background:#e5e7eb;
      margin:4px 0 22px;
    }

    .descripcion-card{
      position:relative;
      background:linear-gradient(135deg, #ffffff, #f8fafc);
      border:1px solid #e8edf4;
      border-radius:20px;
      padding:18px 18px 18px 56px;
      margin-bottom:20px;
    }

    .descripcion-icon{
      position:absolute;
      left:18px;
      top:18px;
      width:28px;
      height:28px;
      border-radius:10px;
      background:#eef2f7;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .descripcion-label{
      text-transform:uppercase;
      letter-spacing:.6px;
      font-size:.75rem;
      color:#64748b;
      font-weight:900;
      margin-bottom:7px;
    }

    .descripcion-text{
      font-size:1.03rem;
      line-height:1.6;
      color:#334155;
      margin:0;
    }

    .admin-panel{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
      margin-bottom:20px;
    }

    .admin-card{
      display:flex;
      align-items:center;
      gap:11px;
      background:#ffffff;
      border:1px solid #e5e7eb;
      border-radius:18px;
      padding:13px;
      box-shadow:0 8px 18px rgba(15,23,42,.05);
      min-width:0;
    }

    .admin-icon{
      width:42px;
      height:42px;
      border-radius:14px;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
      font-size:1.05rem;
    }

    .admin-icon.price{
      background:#ecfdf5;
      border:1px solid #bbf7d0;
      color:#15803d;
    }

    .admin-icon.location{
      background:#eff6ff;
      border:1px solid #bfdbfe;
      color:#2563eb;
    }

    .admin-label{
      display:block;
      font-size:.7rem;
      text-transform:uppercase;
      letter-spacing:.55px;
      color:#64748b;
      font-weight:900;
      margin-bottom:4px;
      white-space:nowrap;
    }

    .admin-value{
      display:block;
      color:#111827;
      font-weight:900;
      font-size:1.05rem;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .actions{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-top:6px;
    }

    .btn-action{
      border-radius:13px;
      font-weight:900;
      padding:11px 17px;
      border:none;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      transition:.18s ease;
    }

    .btn-whatsapp{
      background:linear-gradient(135deg, #25D366, #16a34a);
      color:#ffffff;
      box-shadow:0 10px 18px rgba(37,211,102,.22);
    }

    .btn-whatsapp:hover{
      color:#ffffff;
      transform:translateY(-1px);
      background:linear-gradient(135deg, #1ebe5d, #15803d);
    }

    .btn-whatsapp svg{
      width:19px;
      height:19px;
    }

    .btn-ref{
      background:#ffffff;
      color:#2563eb;
      border:1px solid #bfdbfe;
      box-shadow:0 8px 18px rgba(37,99,235,.08);
    }

    .btn-ref:hover{
      background:#eff6ff;
      color:#1d4ed8;
      transform:translateY(-1px);
    }

    @media(max-width:992px){
      .detalle-grid{
        grid-template-columns:1fr;
      }

      .detalle-img-box{
        height:330px;
      }
    }

    @media(max-width:576px){
      .detalle-info{
        padding:24px 20px 22px;
      }

      .detalle-img-section{
        padding:18px;
      }

      .detalle-img-box{
        height:260px;
      }

      .detalle-title{
        font-size:1.55rem;
      }

      .admin-panel{
        grid-template-columns:1fr;
      }

      .actions{
        display:grid;
        grid-template-columns:1fr;
      }

      .btn-action{
        width:100%;
      }
    }
  </style>
</head>

<body>
  <% const usuarioActual = typeof usuario !== 'undefined' ? usuario : null; %>
  <% const categoriaProducto = producto.categoria || producto.categoria_nombre || 'Sin categoría'; %>
  <% const referenciaProducto = producto.url_referencia || producto.enlace_referencia || producto.referencia_url || producto.url || ''; %>

  <nav class="navbar navbar-expand-lg navbar-dark topbar">
    <div class="container py-2">
      <a class="navbar-brand" href="/catalogo">Sistema Catálogo</a>

      <div class="d-flex gap-2">
        <% if (usuarioActual && usuarioActual.rol === 'admin') { %>
          <a href="/admin/dashboard" class="btn btn-outline-light btn-sm btn-nav">Panel admin</a>
          <a href="/logout" class="btn btn-light btn-sm btn-nav">Cerrar sesión</a>
        <% } else { %>
          <a href="/login" class="btn btn-light btn-sm btn-nav">Acceso admin</a>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="container page-wrap">
    <a href="/catalogo" class="btn-volver">
      ← Volver al catálogo
    </a>

    <section class="detalle-card">
      <div class="detalle-grid">

        <div class="detalle-img-section">
          <div class="detalle-img-box">
            <% if (producto.imagen) { %>
              <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>" class="detalle-img">
            <% } else { %>
              <div class="sin-img">Sin imagen</div>
            <% } %>
          </div>
        </div>

        <div class="detalle-info">
          <h1 class="detalle-title"><%= producto.nombre %></h1>

          <div class="info-tags">
            <span class="info-tag">
              <span class="icon">🏷️</span>
              Marca: <%= producto.marca || 'Sin marca' %>
            </span>

            <span class="info-tag">
              <span class="icon">🗂️</span>
              <%= categoriaProducto %>
            </span>
          </div>

          <div class="stock-card">
            <span class="icon">📦</span>
            <span>Stock: <%= producto.stock %> unidades</span>
          </div>

          <% if (usuarioActual && usuarioActual.rol === 'admin') { %>
            <div class="admin-panel">
              <div class="admin-card">
                <div class="admin-icon price">💵</div>
                <div>
                  <span class="admin-label">Precio interno</span>
                  <span class="admin-value">$<%= Number(producto.precio || 0).toFixed(2) %></span>
                </div>
              </div>

              <div class="admin-card">
                <div class="admin-icon location">📍</div>
                <div>
                  <span class="admin-label">Ubicación interna</span>
                  <span class="admin-value"><%= producto.ubicacion_rack || 'Sin asignar' %></span>
                </div>
              </div>
            </div>
          <% } %>

          <hr class="divider">

          <div class="descripcion-card">
            <span class="descripcion-icon">📝</span>
            <div class="descripcion-label">Descripción</div>
            <p class="descripcion-text">
              <%= producto.descripcion || 'Sin descripción disponible.' %>
            </p>
          </div>

          <div class="actions">
            <a
              href="https://wa.me/?text=Hola,%20quiero%20información%20del%20producto%20<%= encodeURIComponent(producto.nombre) %>"
              target="_blank"
              class="btn-action btn-whatsapp"
            >
              <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                <path d="M19.11 17.2c-.28-.14-1.65-.81-1.9-.9-.25-.09-.43-.14-.61.14-.18.28-.7.9-.85 1.08-.16.19-.31.21-.59.07-.28-.14-1.16-.43-2.21-1.37-.81-.72-1.36-1.61-1.52-1.88-.16-.28-.02-.43.12-.57.13-.13.28-.34.43-.51.14-.17.19-.29.28-.48.09-.19.05-.36-.02-.5-.07-.14-.61-1.47-.84-2.02-.22-.53-.45-.46-.61-.47h-.52c-.18 0-.48.07-.73.34-.25.28-.96.94-.96 2.28 0 1.34.98 2.64 1.12 2.82.14.19 1.93 2.95 4.67 4.13.65.28 1.16.45 1.55.58.65.21 1.24.18 1.71.11.52-.08 1.65-.67 1.88-1.31.23-.64.23-1.19.16-1.31-.07-.11-.25-.18-.52-.32z"/>
                <path d="M16.02 3.2c-7 0-12.68 5.66-12.68 12.64 0 2.23.58 4.41 1.68 6.33L3.2 28.8l6.82-1.79a12.7 12.7 0 0 0 6 1.52h.01c7 0 12.68-5.66 12.68-12.64 0-3.38-1.32-6.56-3.72-8.95A12.62 12.62 0 0 0 16.02 3.2zm0 23.15h-.01a10.56 10.56 0 0 1-5.38-1.47l-.39-.23-4.05 1.06 1.08-3.95-.26-.41a10.45 10.45 0 0 1-1.61-5.57c0-5.8 4.74-10.52 10.58-10.52 2.82 0 5.46 1.09 7.45 3.07a10.44 10.44 0 0 1 3.1 7.45c0 5.8-4.75 10.52-10.59 10.52z"/>
              </svg>
              Contactar por WhatsApp
            </a>

            <% if (usuarioActual && usuarioActual.rol === 'admin' && referenciaProducto) { %>
              <a href="<%= referenciaProducto %>" target="_blank" class="btn-action btn-ref">
                🔗 Ver referencia interna
              </a>
            <% } %>
          </div>
        </div>

      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>