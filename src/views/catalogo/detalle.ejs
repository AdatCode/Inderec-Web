<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= producto.nombre %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .detalle-img{
      width: 100%;
      max-height: 500px;
      object-fit: cover;
      border-radius: 16px;
      background: #f1f1f1;
    }
    .detalle-card{
      border: none;
      border-radius: 18px;
    }
  </style>
</head>
<body class="bg-light">

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/catalogo">Sistema Catálogo</a>
      <div class="d-flex gap-2">
        <% if (usuario && usuario.rol === 'admin') { %>
          <a href="/admin/dashboard" class="btn btn-outline-light btn-sm">Panel admin</a>
          <a href="/logout" class="btn btn-light btn-sm">Cerrar sesión</a>
        <% } else { %>
          <a href="/login" class="btn btn-light btn-sm">Acceso admin</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <a href="/catalogo" class="btn btn-outline-secondary btn-sm mb-4">← Volver al catálogo</a>

    <div class="card shadow detalle-card">
      <div class="card-body p-4">
        <div class="row g-4">
          <div class="col-lg-6">
            <% if (producto.imagen) { %>
              <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>" class="detalle-img">
            <% } else { %>
              <div class="detalle-img d-flex align-items-center justify-content-center">
                <span>Sin imagen</span>
              </div>
            <% } %>
          </div>

          <div class="col-lg-6">
            <h2 class="mb-3"><%= producto.nombre %></h2>

            <p class="mb-2"><strong>Marca:</strong> <%= producto.marca || 'Sin marca' %></p>
            <p class="mb-2"><strong>Categoría:</strong> <%= producto.categoria || 'Sin categoría' %></p>
            <p class="mb-2"><strong>Stock:</strong> <%= producto.stock %></p>
            <p class="mb-2"><strong>Precio:</strong> $<%= Number(producto.precio).toFixed(2) %></p>

            <% if (usuario && usuario.rol === 'admin') { %>
              <p class="mb-2"><strong>Ubicación rack:</strong> <%= producto.ubicacion_rack || '-' %></p>
            <% } %>

            <hr>

            <h5>Descripción</h5>
            <p><%= producto.descripcion %></p>

            <div class="d-flex gap-2 flex-wrap mt-4">
              <a 
                href="https://wa.me/?text=Hola,%20quiero%20información%20del%20producto%20<%= encodeURIComponent(producto.nombre) %>"
                target="_blank"
                class="btn btn-success"
              >
                Contactar por WhatsApp
              </a>

              <% if (producto.enlace_referencia) { %>
                <a href="<%= producto.enlace_referencia %>" target="_blank" class="btn btn-outline-primary">
                  Ver referencia
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</body>
</html>