<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo de productos</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{
      --bg:#f3f6fb;
      --dark:#111827;
      --muted:#64748b;
      --border:#e5e7eb;
      --yellow:#f4b400;
      --yellow-soft:#ffd65a;
      --green:#16a34a;
      --green-dark:#15803d;
      --card:#ffffff;
    }

    *{
      box-sizing:border-box;
    }

    body{
      margin:0;
      font-family:Arial, sans-serif;
      background:
        radial-gradient(circle at 10% 10%, rgba(244,180,0,.08), transparent 22%),
        linear-gradient(135deg, #eef2f7, #f8fafc);
      color:#0f172a;
      min-height:100vh;
    }

    /* ===============================
       TOPBAR COMPACTA CON LOGO
       COLOR FIJO + FIGURAS ALEATORIAS
    =============================== */

    .topbar{
      --topbar-grad-1:#1b3440;
      --topbar-grad-2:#0f766e;
      --topbar-accent-1:rgba(45,212,191,.18);
      --topbar-accent-2:rgba(255,255,255,.08);

      position:relative;
      overflow:hidden;
      background:linear-gradient(135deg, var(--topbar-grad-1), var(--topbar-grad-2));
      border-bottom:1px solid rgba(255,255,255,.06);
      box-shadow:0 10px 24px rgba(15,23,42,.12);
      height:74px;
      min-height:74px;
    }

    .topbar-inner{
      width:100%;
      max-width:1660px;
      height:74px;
      min-height:74px;
      margin:0 auto;
      padding:0 48px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
      position:relative;
      z-index:3;
    }

    .logo-brand{
      height:74px;
      display:flex;
      align-items:center;
      justify-content:flex-start;
      padding:0;
      margin:0;
      text-decoration:none;
      position:relative;
      z-index:4;
    }

    .brand-logo{
      height:46px;
      width:auto;
      object-fit:contain;
      display:block;
      transform:scale(2.65);
      transform-origin:left center;
      filter:drop-shadow(0 8px 16px rgba(0,0,0,.25));
    }

    .topbar-shapes{
      position:absolute;
      inset:0;
      pointer-events:none;
      z-index:1;
    }

    .shape{
      position:absolute;
      display:block;
      border-radius:50%;
      background:var(--topbar-accent-1);
      animation:floatTopbar 7s ease-in-out infinite;
    }

    .shape-1{
      width:118px;
      height:118px;
      right:11%;
      top:-38px;
      opacity:.75;
    }

    .shape-2{
      width:80px;
      height:80px;
      right:4%;
      bottom:-28px;
      background:var(--topbar-accent-2);
      opacity:.95;
      animation-delay:.9s;
    }

    .shape-3{
      width:66px;
      height:66px;
      left:18%;
      top:-28px;
      background:rgba(255,255,255,.06);
      opacity:.75;
      animation-delay:1.5s;
    }

    .shape-4{
      position:absolute;
      right:24%;
      bottom:-18px;
      width:150px;
      height:3px;
      border-radius:999px;
      background:linear-gradient(90deg, transparent, var(--topbar-accent-1), transparent);
      box-shadow:0 0 18px var(--topbar-accent-1);
      animation:lineTopbar 4s ease-in-out infinite;
    }

    /* VARIANTE 1: BURBUJAS */
    .topbar-bubbles .shape-1{
      right:12%;
      top:-40px;
      width:125px;
      height:125px;
      border-radius:50%;
    }

    .topbar-bubbles .shape-2{
      right:4%;
      bottom:-30px;
      width:86px;
      height:86px;
      border-radius:50%;
    }

    .topbar-bubbles .shape-3{
      left:18%;
      top:-28px;
      width:72px;
      height:72px;
    }

    /* VARIANTE 2: ANILLOS */
    .topbar-rings .shape-1{
      right:10%;
      top:-42px;
      width:130px;
      height:130px;
      background:transparent;
      border:3px solid rgba(255,255,255,.12);
      box-shadow:0 0 22px rgba(45,212,191,.20);
    }

    .topbar-rings .shape-2{
      right:5%;
      bottom:-34px;
      width:95px;
      height:95px;
      background:transparent;
      border:2px solid rgba(255,255,255,.10);
    }

    .topbar-rings .shape-3{
      left:22%;
      top:-34px;
      width:80px;
      height:80px;
      background:transparent;
      border:2px solid rgba(255,255,255,.08);
    }

    /* VARIANTE 3: DIAGONAL */
    .topbar-diagonal .shape-1{
      right:8%;
      top:-25px;
      width:220px;
      height:80px;
      border-radius:30px;
      transform:rotate(-18deg);
      background:rgba(255,255,255,.09);
      animation:floatDiagonal 7s ease-in-out infinite;
    }

    .topbar-diagonal .shape-2{
      right:22%;
      bottom:-28px;
      width:180px;
      height:54px;
      border-radius:28px;
      transform:rotate(-18deg);
      background:rgba(45,212,191,.16);
      animation:floatDiagonal 7s ease-in-out infinite;
      animation-delay:.8s;
    }

    .topbar-diagonal .shape-3{
      left:18%;
      top:-18px;
      width:150px;
      height:42px;
      border-radius:999px;
      transform:rotate(-18deg);
      animation:floatDiagonal 7s ease-in-out infinite;
      animation-delay:1.3s;
    }

    /* VARIANTE 4: ONDAS */
    .topbar-waves .shape-1{
      right:8%;
      top:-48px;
      width:190px;
      height:120px;
      border-radius:60% 40% 45% 55%;
      background:rgba(255,255,255,.10);
    }

    .topbar-waves .shape-2{
      right:3%;
      bottom:-45px;
      width:150px;
      height:110px;
      border-radius:45% 55% 60% 40%;
      background:rgba(45,212,191,.17);
    }

    .topbar-waves .shape-3{
      left:20%;
      top:-40px;
      width:105px;
      height:80px;
      border-radius:50% 40% 60% 45%;
    }

    /* VARIANTE 5: GLASS */
    .topbar-glass .shape-1{
      right:9%;
      top:12px;
      width:190px;
      height:58px;
      border-radius:22px;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.12);
      backdrop-filter:blur(8px);
      transform:rotate(-5deg);
      animation:floatGlass 7s ease-in-out infinite;
    }

    .topbar-glass .shape-2{
      right:4%;
      bottom:10px;
      width:120px;
      height:48px;
      border-radius:20px;
      background:rgba(45,212,191,.12);
      border:1px solid rgba(255,255,255,.10);
      transform:rotate(6deg);
      animation:floatGlassReverse 7s ease-in-out infinite;
      animation-delay:.8s;
    }

    .topbar-glass .shape-3{
      left:18%;
      top:-22px;
      width:74px;
      height:74px;
      border-radius:22px;
      background:rgba(255,255,255,.06);
      transform:rotate(12deg);
      animation:floatGlass 7s ease-in-out infinite;
      animation-delay:1.4s;
    }

    @keyframes floatTopbar{
      0%,100%{
        transform:translateY(0) scale(1);
      }
      50%{
        transform:translateY(9px) scale(1.05);
      }
    }

    @keyframes floatDiagonal{
      0%,100%{
        transform:rotate(-18deg) translateY(0) scale(1);
      }
      50%{
        transform:rotate(-18deg) translateY(9px) scale(1.04);
      }
    }

    @keyframes floatGlass{
      0%,100%{
        transform:rotate(-5deg) translateY(0);
      }
      50%{
        transform:rotate(-5deg) translateY(9px);
      }
    }

    @keyframes floatGlassReverse{
      0%,100%{
        transform:rotate(6deg) translateY(0);
      }
      50%{
        transform:rotate(6deg) translateY(-8px);
      }
    }

    @keyframes lineTopbar{
      0%,100%{
        opacity:.35;
        transform:scaleX(.8);
      }
      50%{
        opacity:1;
        transform:scaleX(1.05);
      }
    }

    .catalog-header-actions{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
      position:relative;
      z-index:3;
    }

    .catalog-header-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:7px;
      padding:10px 18px;
      border-radius:999px;
      background:linear-gradient(135deg, #f4b400, #ffd65a);
      color:#111827;
      font-size:.92rem;
      font-weight:900;
      text-decoration:none;
      border:none;
      box-shadow:0 10px 22px rgba(244,180,0,.24);
      transition:all .18s ease;
      white-space:nowrap;
    }

    .catalog-header-btn:hover{
      color:#111827;
      transform:translateY(-2px);
      background:linear-gradient(135deg, #ffd65a, #f4b400);
      box-shadow:0 14px 30px rgba(244,180,0,.34);
    }

    .catalog-header-btn:active{
      transform:translateY(0);
    }

    /* ===============================
       CONTENIDO
    =============================== */

    .catalog-wrap{
      max-width:1350px;
      margin:0 auto;
      padding:28px 48px 60px;
    }

    .catalog-title{
      font-size:2.45rem;
      font-weight:900;
      margin:0 0 24px;
      color:#0f172a;
      letter-spacing:.2px;
    }

    .search-panel{
  max-width:1320px;
  margin:0 auto 22px;
  background:#ffffff;
  border:1px solid #e5e7eb;
  border-radius:22px;
  padding:20px;
  box-shadow:0 16px 36px rgba(15,23,42,.07);
  position:relative;
  z-index:10;
    }

    .search-row{
  display:grid;
  grid-template-columns:minmax(0, 1fr) auto;
  gap:14px;
  align-items:center;
}

    .search-box{
      position:relative;
      display:flex;
      align-items:center;
      gap:12px;
      border:1px solid #dbe3ee;
      border-radius:18px;
      background:#ffffff;
      padding:10px 12px;
      min-height:58px;
      transition:.18s ease;
    }

    .search-box:focus-within{
      border-color:#f4b400;
      box-shadow:0 0 0 4px rgba(244,180,0,.14);
    }

    .search-icon{
      width:42px;
      height:42px;
      border-radius:14px;
      background:#fff7db;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:1.4rem;
      flex-shrink:0;
    }

    .search-input{
      border:none;
      outline:none;
      width:100%;
      font-size:1rem;
      font-weight:700;
      color:#0f172a;
      background:transparent;
    }

    .search-input::placeholder{
      color:#64748b;
      font-weight:600;
    }

    .btn-clear{
      border:none;
      border-radius:14px;
      background:#f1f5f9;
      color:#475569;
      font-weight:900;
      padding:12px 18px;
      transition:.18s ease;
    }

    .btn-clear:hover{
      background:#e2e8f0;
      color:#111827;
    }

    .count-pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius:16px;
      border:1px solid #e5e7eb;
      background:#ffffff;
      color:#475569;
      font-weight:900;
      padding:14px 18px;
      box-shadow:0 10px 22px rgba(15,23,42,.05);
      white-space:nowrap;
    }

    .suggestions{
      position:absolute;
      left:20px;
      right:20px;
      top:calc(100% - 10px);
      background:#ffffff;
      border:1px solid #e5e7eb;
      border-radius:18px;
      box-shadow:0 18px 38px rgba(15,23,42,.14);
      overflow:hidden;
      display:none;
      z-index:50;
      max-height:280px;
      overflow-y:auto;
    }

    .suggestions.show{
      display:block;
    }

    .suggestion-item{
      display:flex;
      align-items:center;
      gap:12px;
      padding:12px 14px;
      cursor:pointer;
      border-bottom:1px solid #f1f5f9;
      transition:.15s ease;
    }

    .suggestion-item:hover{
      background:#f8fafc;
    }

    .suggestion-img{
      width:42px;
      height:42px;
      object-fit:contain;
      border-radius:10px;
      border:1px solid #e5e7eb;
      background:#fff;
      flex-shrink:0;
    }

    .suggestion-name{
      font-weight:900;
      color:#0f172a;
      line-height:1.2;
    }

    .suggestion-meta{
      font-size:.82rem;
      color:#64748b;
      font-weight:700;
      margin-top:2px;
    }

    .filter-row{
  max-width:1320px;
  margin:0 auto 30px;
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
  position:relative;
  z-index:8;
}

    .filter-btn,
    .category-trigger,
    .category-label{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      border-radius:16px;
      padding:12px 18px;
      font-weight:900;
      text-decoration:none;
      border:1px solid #dbe3ee;
      background:#ffffff;
      color:#111827;
      box-shadow:0 8px 20px rgba(15,23,42,.04);
      transition:.18s ease;
    }

    .filter-btn.active{
      background:linear-gradient(135deg, #f4b400, #ffd65a);
      border-color:#f4b400;
      box-shadow:0 14px 26px rgba(244,180,0,.22);
    }

    .category-wrapper{
      position:relative;
    }

    .category-trigger{
      cursor:pointer;
    }

    .category-menu{
      position:absolute;
      top:calc(100% + 8px);
      left:0;
      min-width:260px;
      background:#ffffff;
      border:1px solid #e5e7eb;
      border-radius:16px;
      box-shadow:0 18px 38px rgba(15,23,42,.14);
      padding:8px;
      display:none;
      z-index:40;
      max-height:300px;
      overflow-y:auto;
    }

    .category-menu.show{
      display:block;
    }

    .category-option{
      width:100%;
      border:none;
      background:transparent;
      text-align:left;
      border-radius:12px;
      padding:10px 12px;
      font-weight:800;
      color:#334155;
      transition:.15s ease;
    }

    .category-option:hover{
      background:#f8fafc;
      color:#111827;
    }

    .category-label{
      color:#475569;
      background:#ffffff;
    }

    .products-grid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:26px;
    }

    .product-card{
      background:#ffffff;
      border:1px solid #edf1f7;
      border-radius:24px;
      overflow:hidden;
      box-shadow:0 16px 34px rgba(15,23,42,.07);
      transition:.2s ease;
      display:flex;
      flex-direction:column;
      min-height:100%;
    }

    .product-card:hover{
      transform:translateY(-4px);
      box-shadow:0 24px 46px rgba(15,23,42,.12);
    }

    .product-media{
      height:255px;
      background:#ffffff;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:24px;
      border-bottom:1px solid #eef2f7;
      position:relative;
      overflow:hidden;
    }

    .product-media img{
      max-width:100%;
      max-height:100%;
      object-fit:contain;
      display:block;
    }

    .category-badge-overlay{
      position:absolute;
      top:14px;
      left:14px;
      z-index:5;
      display:inline-flex;
      align-items:center;
      gap:6px;
      max-width:72%;
      padding:6px 10px;
      border-radius:999px;
      background:rgba(255,255,255,.92);
      border:1px solid #dbe3ee;
      color:#334155;
      font-size:.72rem;
      font-weight:900;
      box-shadow:0 8px 18px rgba(15,23,42,.08);
      backdrop-filter:blur(8px);
    }

    .category-badge-overlay .badge-icon{
      width:20px;
      height:20px;
      border-radius:999px;
      background:#fff7db;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      font-size:.78rem;
      flex-shrink:0;
    }

    .category-badge-overlay .badge-text{
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .image-placeholder{
      display:none;
      align-items:center;
      justify-content:center;
      width:100%;
      height:100%;
      color:#64748b;
      font-weight:900;
      font-size:1rem;
      text-align:center;
    }

    .product-media.no-image .image-placeholder,
    .product-media.image-error .image-placeholder{
      display:flex;
    }

    .product-body{
      padding:22px;
      display:flex;
      flex-direction:column;
      gap:14px;
      flex:1;
    }

    .product-title{
      font-size:1.1rem;
      font-weight:900;
      color:#020617;
      line-height:1.25;
      margin:0;
      min-height:2.7em;
    }

    .brand-pill,
    .stock-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      border-radius:999px;
      padding:9px 13px;
      width:max-content;
      max-width:100%;
      border:1px solid #e5e7eb;
      background:#f8fafc;
      color:#334155;
      font-size:.9rem;
      font-weight:900;
    }

    .pill-icon{
      width:25px;
      height:25px;
      border-radius:999px;
      background:#ffffff;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }

    .description-box{
      border:1px solid #e5e7eb;
      background:linear-gradient(135deg, #ffffff, #f8fafc);
      border-radius:16px;
      padding:14px;
      min-height:86px;
    }

    .description-label{
      display:flex;
      align-items:center;
      gap:7px;
      font-size:.78rem;
      color:#64748b;
      font-weight:900;
      letter-spacing:.5px;
      text-transform:uppercase;
      margin-bottom:8px;
    }

    .description-text{
      color:#334155;
      font-weight:600;
      line-height:1.45;
      margin:0;
      display:-webkit-box;
      -webkit-line-clamp:3;
      -webkit-box-orient:vertical;
      overflow:hidden;
    }

    .stock-pill{
      background:#ecfdf5;
      border-color:#bbf7d0;
      color:#166534;
    }

    .admin-meta{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
    }

    .meta-box{
      border:1px solid #e5e7eb;
      border-radius:16px;
      padding:12px;
      background:#f8fafc;
      display:flex;
      align-items:center;
      gap:10px;
    }

    .meta-icon{
      width:34px;
      height:34px;
      border-radius:12px;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#ffffff;
      flex-shrink:0;
      font-size:1.1rem;
    }

    .meta-label{
      color:#64748b;
      font-size:.72rem;
      text-transform:uppercase;
      letter-spacing:.45px;
      font-weight:900;
    }

    .meta-value{
      color:#0f172a;
      font-weight:900;
      margin-top:2px;
      line-height:1.2;
      word-break:break-word;
    }

    .product-actions{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin-top:auto;
    }

    .btn-detail,
    .btn-whatsapp{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      border-radius:14px;
      padding:12px 14px;
      font-weight:900;
      text-decoration:none;
      transition:.18s ease;
    }

    .btn-detail{
      background:#111827;
      color:#ffffff;
    }

    .btn-detail:hover{
      color:#ffffff;
      background:#374151;
      transform:translateY(-1px);
    }

    .btn-whatsapp{
      background:#16a34a;
      color:#ffffff;
    }

    .btn-whatsapp:hover{
      color:#ffffff;
      background:#15803d;
      transform:translateY(-1px);
    }

    .empty-state{
      grid-column:1 / -1;
      background:#ffffff;
      border:1px solid #e5e7eb;
      border-radius:24px;
      padding:40px;
      text-align:center;
      box-shadow:0 16px 34px rgba(15,23,42,.06);
    }

    .empty-state h3{
      font-weight:900;
      margin-bottom:8px;
    }

    .empty-state p{
      color:#64748b;
      font-weight:700;
      margin:0;
    }

    .hidden-product{
      display:none !important;
    }

    @media(max-width:992px){
      .products-grid{
        grid-template-columns:repeat(2, 1fr);
      }

      .search-row{
        grid-template-columns:1fr;
      }

      .count-pill{
        width:max-content;
      }
    }

    @media(max-width:768px){
      .topbar{
        height:auto;
        min-height:auto;
      }

      .topbar-inner{
        height:auto;
        min-height:auto;
        padding:12px 16px;
        flex-direction:column;
        align-items:flex-start;
      }

      .logo-brand{
        height:54px;
      }

      .brand-logo{
        height:38px;
        transform:scale(1.25);
      }

      .catalog-wrap{
        padding:24px 16px 46px;
      }

      .catalog-header-actions{
        width:100%;
        display:grid;
        grid-template-columns:1fr;
      }

      .catalog-header-btn{
        width:100%;
      }

      .shape-3,
      .shape-4{
        display:none;
      }

      .catalog-title{
        font-size:2rem;
      }

      .products-grid{
        grid-template-columns:1fr;
      }

      .product-media{
        height:210px;
      }

      .category-badge-overlay{
        top:10px;
        left:10px;
        max-width:78%;
        font-size:.68rem;
        padding:5px 9px;
      }

      .admin-meta{
        grid-template-columns:1fr;
      }

      .product-actions{
        grid-template-columns:1fr;
      }

      .filter-row{
        align-items:stretch;
      }

      .filter-btn,
      .category-trigger,
      .category-label{
        width:100%;
      }

      .category-wrapper{
        width:100%;
      }

      .category-menu{
        width:100%;
      }
    }
    /* Ajuste botones superiores catálogo */
.catalog-header-actions{
  gap:8px !important;
  transform:translateX(-80px);
}

.catalog-header-btn{
  padding:8px 14px !important;
  font-size:.82rem !important;
  border-radius:999px !important;
}
/* ===== MEJORAR IMÁGENES DE PRODUCTOS ===== */

.product-media{
  height:300px !important;
  padding:18px !important;
  background:#ffffff !important;
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  overflow:hidden !important;
}

/* Esto hace que la imagen crezca y use mejor el espacio */
.product-media img{
  width:92% !important;
  height:92% !important;
  max-width:92% !important;
  max-height:92% !important;
  object-fit:contain !important;
  display:block !important;
  transition:transform .22s ease;
}

.product-card:hover .product-media img{
  transform:scale(1.06);
}

/* Para imágenes pequeñas cuadradas */
.product-media.image-error,
.product-media.no-image{
  background:#ffffff !important;
}

/* ===== DESCRIPCIÓN CON VER MÁS ===== */

.description-box{
  position:relative;
  transition:all .22s ease;
}

.description-text{
  color:#334155;
  font-weight:600;
  line-height:1.45;
  margin:0;
  display:-webkit-box;
  line-clamp:3;
  -webkit-line-clamp:3;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

/* Cuando se abre */
.description-box.expanded .description-text{
  display:block;
  line-clamp:unset;
  -webkit-line-clamp:unset;
  overflow:visible;
}

/* Botón Ver más */
.btn-read-more{
  margin-top:10px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border:none;
  background:linear-gradient(135deg, #f4b400, #ffd65a);
  color:#111827;
  font-weight:900;
  font-size:.82rem;
  padding:7px 12px;
  border-radius:999px;
  cursor:pointer;
  box-shadow:0 8px 18px rgba(244,180,0,.20);
  transition:all .18s ease;
}

.btn-read-more:hover{
  transform:translateY(-1px);
  background:linear-gradient(135deg, #ffd65a, #f4b400);
  box-shadow:0 12px 24px rgba(244,180,0,.30);
}

/* Si la descripción es corta, se oculta el botón */
.btn-read-more.hidden{
  display:none;
}

@media(max-width:768px){
  .product-media{
    height:250px !important;
  }

  .product-media img{
    width:94% !important;
    height:94% !important;
    max-width:94% !important;
    max-height:94% !important;
  }
}   
/* ===== VER MÁS MÁS PEQUEÑO SIN BAJAR LA TARJETA ===== */

.description-box{
  min-height:128px !important;
  max-height:128px !important;
  display:flex !important;
  flex-direction:column !important;
  overflow:hidden !important;
}

.description-text{
  color:#334155;
  font-weight:600;
  line-height:1.45;
  margin:0;
  display:-webkit-box;
  line-clamp:3;
  -webkit-line-clamp:3;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

/* Botón pequeño tipo enlace */
.btn-read-more{
  margin-top:auto !important;
  align-self:flex-start !important;
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  border:none !important;
  background:transparent !important;
  color:#0f766e !important;
  font-weight:900 !important;
  font-size:.78rem !important;
  padding:4px 0 !important;
  border-radius:0 !important;
  cursor:pointer !important;
  box-shadow:none !important;
  transition:all .15s ease !important;
}

.btn-read-more:hover{
  color:#064e3b !important;
  background:transparent !important;
  box-shadow:none !important;
  transform:none !important;
  text-decoration:underline !important;
}

.btn-read-more.hidden{
  display:none !important;
}

/* Ya no expandimos dentro de la tarjeta */
.description-box.expanded .description-text{
  display:-webkit-box !important;
  line-clamp:3 !important;
  -webkit-line-clamp:3 !important;
  -webkit-box-orient:vertical !important;
  overflow:hidden !important;
}

/* ===== MODAL DESCRIPCIÓN ===== */

.desc-modal{
  position:fixed;
  inset:0;
  background:rgba(15,23,42,.55);
  backdrop-filter:blur(6px);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:9999;
  padding:18px;
}

.desc-modal.show{
  display:flex;
}

.desc-modal-card{
  width:min(680px, 100%);
  background:#ffffff;
  border-radius:24px;
  box-shadow:0 30px 80px rgba(15,23,42,.28);
  overflow:hidden;
  animation:modalIn .18s ease both;
}

.desc-modal-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:20px 22px;
  border-bottom:1px solid #e5e7eb;
}

.desc-modal-title{
  font-size:1.25rem;
  font-weight:900;
  color:#0f172a;
  margin:0;
}

.desc-modal-close{
  width:38px;
  height:38px;
  border-radius:999px;
  border:none;
  background:#f1f5f9;
  color:#111827;
  font-weight:900;
  font-size:1.3rem;
  cursor:pointer;
}

.desc-modal-body{
  padding:22px;
}

.desc-modal-label{
  color:#64748b;
  font-size:.78rem;
  font-weight:900;
  letter-spacing:.5px;
  text-transform:uppercase;
  margin-bottom:10px;
}

.desc-modal-text{
  color:#1e293b;
  font-weight:700;
  line-height:1.65;
  white-space:pre-line;
  margin:0;
}

@keyframes modalIn{
  from{
    opacity:0;
    transform:translateY(12px) scale(.98);
  }
  to{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}

/* ===== ALINEAR STOCK / PRECIO / UBICACIÓN / BOTONES ===== */

.products-grid{
  align-items:stretch !important;
}

.product-card{
  height:100% !important;
  display:flex !important;
  flex-direction:column !important;
}

.product-body{
  flex:1 !important;
  display:flex !important;
  flex-direction:column !important;
}

/* Este bloque se va siempre hacia abajo */
.product-bottom{
  margin-top:auto !important;
  display:flex !important;
  flex-direction:column !important;
  gap:14px !important;
}

/* Para que el stock siempre tenga el mismo alto */
.stock-pill{
  min-height:50px !important;
}

/* Para que precio y ubicación mantengan la misma altura */
.admin-meta{
  display:grid !important;
  grid-template-columns:1fr 1fr !important;
  gap:10px !important;
  min-height:80px !important;
}

.meta-box{
  min-height:72px !important;
  align-items:center !important;
}

/* Botones siempre abajo */
.product-actions{
  margin-top:0 !important;
}

/* En celular */
@media(max-width:768px){
  .admin-meta{
    grid-template-columns:1fr !important;
    min-height:auto !important;
  }

  .meta-box{
    min-height:66px !important;
  }

  .product-bottom{
    gap:12px !important;
  }
}
/* ===== VER MÁS / VER MENOS ===== */

.description-box{
  min-height:128px !important;
  max-height:none !important;
  overflow:hidden !important;
}

.description-text{
  display:-webkit-box !important;
  line-clamp:3 !important;
  -webkit-line-clamp:3 !important;
  -webkit-box-orient:vertical !important;
  overflow:hidden !important;
}

/* Cuando se abre */
.description-box.expanded .description-text{
  display:block !important;
  line-clamp:unset !important;
  -webkit-line-clamp:unset !important;
  -webkit-box-orient:unset !important;
  overflow:visible !important;
}

/* Texto pequeño tipo enlace */
.btn-read-more{
  margin-top:6px !important;
  border:none !important;
  background:transparent !important;
  color:#0f766e !important;
  font-weight:900 !important;
  font-size:.78rem !important;
  padding:0 !important;
  cursor:pointer !important;
  box-shadow:none !important;
}

.btn-read-more:hover{
  color:#064e3b !important;
  text-decoration:underline !important;
}

.btn-read-more.hidden{
  display:none !important;
}
/* ===== SOLO TEXTO DE LA DESCRIPCIÓN MÁS FINO ===== */

.description-box .description-text{
  font-family:"Segoe UI", Arial, sans-serif !important;
  font-size:.95rem !important;
  font-weight:475 !important;
  line-height:1.55 !important;
  color:#334155 !important;
  letter-spacing:0 !important;
}
/* ===== FIX FILTRO BUSCADOR / CATEGORÍA ===== */
.hidden-product{
  display:none !important;
}
  </style>
</head>

<body>
  <%
    const listaProductos = typeof productos !== 'undefined' && Array.isArray(productos) ? productos : [];
    const listaCategorias = typeof categorias !== 'undefined' && Array.isArray(categorias) ? categorias : [];

    const usuarioActual = typeof usuario !== 'undefined' ? usuario : null;
    const esAdminCatalogo = usuarioActual && (
      usuarioActual.rol === 'admin' ||
      usuarioActual.role === 'admin' ||
      usuarioActual.tipo === 'admin' ||
      usuarioActual.es_admin === 1 ||
      usuarioActual.es_admin === true
    );
  %>

  <nav class="topbar topbar-dynamic">
    <div class="topbar-shapes">
      <span class="shape shape-1"></span>
      <span class="shape shape-2"></span>
      <span class="shape shape-3"></span>
      <span class="shape-4"></span>
    </div>

    <div class="topbar-inner">
      <a class="logo-brand" href="/catalogo">
        <img src="/img/indemarc.png" alt="INDEMARC" class="brand-logo">
      </a>

      <% if (esAdminCatalogo) { %>
        <div class="catalog-header-actions">
          <a href="/admin/dashboard" class="catalog-header-btn">
            🏠 Panel admin
          </a>

          <a href="/logout" class="catalog-header-btn">
            🔒 Cerrar sesión
          </a>
        </div>
      <% } else { %>
        <div class="catalog-header-actions">
          <a href="/login" class="catalog-header-btn">
            🔑 Acceso admin
          </a>
        </div>
      <% } %>
    </div>
  </nav>

  <main class="catalog-wrap">
    

    <section class="search-panel">
      <div class="search-row">
        <div class="search-box">
          <div class="search-icon">🔎</div>

          <input 
            type="text" 
            id="searchInput" 
            class="search-input" 
            placeholder="Buscar producto, marca o categoría..."
            autocomplete="off"
          >

          <button type="button" id="clearSearch" class="btn-clear">
            Limpiar
          </button>
        </div>

        <div class="count-pill" id="productCount">
          Mostrando <%= listaProductos.length %> productos
        </div>
      </div>

      <div class="suggestions" id="suggestions"></div>
    </section>

    <section class="filter-row">
      <button type="button" class="filter-btn active" id="btnAll">
        📦 Todos
      </button>

      <div class="category-wrapper">
        <button type="button" class="category-trigger" id="categoryTrigger">
          Categorías ▾
        </button>

        <div class="category-menu" id="categoryMenu">
          <% listaCategorias.forEach(categoria => { %>
            <button 
              type="button" 
              class="category-option" 
              data-category="<%= categoria.nombre %>"
            >
              <%= categoria.nombre %>
            </button>
          <% }) %>
        </div>
      </div>

      <div class="category-label" id="categoryLabel">
        Categoría: Todas
      </div>
    </section>

    <section class="products-grid" id="productsGrid">
      <% if (listaProductos.length === 0) { %>
        <div class="empty-state">
          <h3>No hay productos registrados</h3>
          <p>Cuando agregues productos aparecerán aquí.</p>
        </div>
      <% } %>

      <% listaProductos.forEach(producto => { %>
        <%
          const productoId = producto.id || producto.id_producto;
          const nombreProducto = producto.nombre || 'Producto sin nombre';
          const marcaProducto = producto.marca || producto.marca_nombre || 'Sin marca';
          const categoriaProducto = producto.categoria || producto.categoria_nombre || 'Sin categoría';
          const descripcionProducto = producto.descripcion || 'Sin descripción disponible.';
          const stockProducto = producto.stock || 0;
          const ubicacionProducto = producto.ubicacion_rack || producto.ubicacion || 'Sin asignar';

          const precioNumero = Number(String(producto.precio || 0).replace(',', '.'));
          const precioMostrar = Number.isFinite(precioNumero) ? precioNumero.toFixed(2) : '0.00';

          const textoWhatsapp = encodeURIComponent(`Hola, estoy interesado en este producto: ${nombreProducto}`);
        %>

        <article 
          class="product-card"
          data-name="<%= nombreProducto.toLowerCase() %>"
          data-brand="<%= marcaProducto.toLowerCase() %>"
          data-category="<%= categoriaProducto.toLowerCase() %>"
          data-description="<%= descripcionProducto.toLowerCase() %>"
        >
          <div class="product-media <%= producto.imagen ? '' : 'no-image' %>">
            <div class="category-badge-overlay" title="<%= categoriaProducto %>">
              <span class="badge-icon">🗂️</span>
              <span class="badge-text"><%= categoriaProducto %></span>
            </div>

            <% if (producto.imagen) { %>
              <img 
                src="<%= producto.imagen %>" 
                alt="<%= nombreProducto %>"
                onerror="this.closest('.product-media').classList.add('image-error'); this.remove();"
              >
            <% } %>

            <div class="image-placeholder">
              Sin imagen
            </div>
          </div>

          <div class="product-body">
            <h2 class="product-title">
              <%= nombreProducto %>
            </h2>

            <div class="brand-pill">
              <span class="pill-icon">🏷️</span>
              Marca: <%= marcaProducto %>
            </div>

            <div class="description-box">
  <div class="description-label">
    📝 Descripción
  </div>

  <p class="description-text">
    <%= descripcionProducto %>
  </p>

  <button type="button" class="btn-read-more">
    Ver más
  </button>
</div>

            <div class="product-bottom">
  <div class="stock-pill">
    <span class="pill-icon">📦</span>
    Stock: <%= stockProducto %>
  </div>

  <% if (esAdminCatalogo) { %>
    <div class="admin-meta">
      <div class="meta-box">
        <div class="meta-icon">💲</div>
        <div>
          <div class="meta-label">Precio</div>
          <div class="meta-value">$<%= precioMostrar %></div>
        </div>
      </div>

      <div class="meta-box">
        <div class="meta-icon">📍</div>
        <div>
          <div class="meta-label">Ubicación</div>
          <div class="meta-value"><%= ubicacionProducto %></div>
        </div>
      </div>
    </div>
  <% } %>

  <div class="product-actions">
    <a href="/catalogo/producto/<%= productoId %>" class="btn-detail">
      Ver detalle
    </a>

    <a 
      href="https://wa.me/?text=<%= textoWhatsapp %>" 
      target="_blank" 
      rel="noopener"
      class="btn-whatsapp"
    >
      WhatsApp
    </a>
  </div>

          
        </article>
      <% }) %>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const topbar = document.querySelector('.topbar-dynamic');

      if (topbar) {
        const shapeVariants = [
          'topbar-bubbles',
          'topbar-rings',
          'topbar-diagonal',
          'topbar-waves',
          'topbar-glass'
        ];

        const selectedVariant = shapeVariants[Math.floor(Math.random() * shapeVariants.length)];
        topbar.classList.add(selectedVariant);
      }

      const searchInput = document.getElementById('searchInput');
      const clearSearch = document.getElementById('clearSearch');
      const productCards = Array.from(document.querySelectorAll('.product-card'));
      const productCount = document.getElementById('productCount');
      const btnAll = document.getElementById('btnAll');
      const categoryTrigger = document.getElementById('categoryTrigger');
      const categoryMenu = document.getElementById('categoryMenu');
      const categoryOptions = Array.from(document.querySelectorAll('.category-option'));
      const categoryLabel = document.getElementById('categoryLabel');
      const suggestions = document.getElementById('suggestions');

      let currentCategory = '';

      function normalize(text) {
        return String(text || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }
// Ver más / Ver menos dentro de la tarjeta y cerrar al hacer clic afuera
function cerrarDescripcionesAbiertas(exceptoBox = null) {
  document.querySelectorAll('.description-box.expanded').forEach(box => {
    if (box === exceptoBox) return;

    const button = box.querySelector('.btn-read-more');

    box.classList.remove('expanded');

    if (button) {
      button.textContent = 'Ver más';
    }
  });
}

document.querySelectorAll('.description-box').forEach(box => {
  const text = box.querySelector('.description-text');
  const button = box.querySelector('.btn-read-more');

  if (!text || !button) return;

  box.classList.remove('expanded');
  button.textContent = 'Ver más';

  // Ocultar botón si el texto no necesita expandirse
  setTimeout(() => {
    const necesitaVerMas = text.scrollHeight > text.clientHeight + 2;

    if (!necesitaVerMas) {
      button.classList.add('hidden');
    } else {
      button.classList.remove('hidden');
    }
  }, 120);

  button.addEventListener('click', event => {
    event.preventDefault();
    event.stopPropagation();

    const estaAbierto = box.classList.contains('expanded');

    // Cierra otros abiertos
    cerrarDescripcionesAbiertas(box);

    if (estaAbierto) {
      box.classList.remove('expanded');
      button.textContent = 'Ver más';
    } else {
      box.classList.add('expanded');
      button.textContent = 'Ver menos';
    }
  });

  // Para que no se cierre al hacer clic dentro del cuadro de descripción
  box.addEventListener('click', event => {
    event.stopPropagation();
  });
});

// Si das clic fuera de la descripción, se cierra solo
document.addEventListener('click', () => {
  cerrarDescripcionesAbiertas();
});
      function updateProducts() {
        const query = normalize(searchInput.value);
        const category = normalize(currentCategory);

        let visibleCount = 0;

        productCards.forEach(card => {
          const searchable = normalize(
            card.dataset.name + ' ' +
            card.dataset.brand + ' ' +
            card.dataset.category + ' ' +
            card.dataset.description
          );

          const productCategory = normalize(card.dataset.category);

          const matchesSearch = !query || searchable.includes(query);
          const matchesCategory = !category || productCategory === category;

          if (matchesSearch && matchesCategory) {
            card.classList.remove('hidden-product');
            visibleCount++;
          } else {
            card.classList.add('hidden-product');
          }
        });

        productCount.textContent = `Mostrando ${visibleCount} productos`;
      }

      function updateSuggestions() {
        const query = normalize(searchInput.value);

        if (!query || query.length < 1) {
          suggestions.classList.remove('show');
          suggestions.innerHTML = '';
          return;
        }

        const matches = productCards
          .filter(card => {
            const searchable = normalize(
              card.dataset.name + ' ' +
              card.dataset.brand + ' ' +
              card.dataset.category
            );
            return searchable.includes(query);
          })
          .slice(0, 6);

        if (matches.length === 0) {
          suggestions.classList.remove('show');
          suggestions.innerHTML = '';
          return;
        }

        suggestions.innerHTML = matches.map(card => {
          const title = card.querySelector('.product-title')?.textContent.trim() || 'Producto';
          const brand = card.querySelector('.brand-pill')?.textContent.trim() || '';
          const img = card.querySelector('.product-media img')?.getAttribute('src') || '';

          return `
            <div class="suggestion-item" data-title="${title.replace(/"/g, '&quot;')}">
              ${
                img 
                  ? `<img class="suggestion-img" src="${img}" alt="${title}">` 
                  : `<div class="suggestion-img d-flex align-items-center justify-content-center">📦</div>`
              }
              <div>
                <div class="suggestion-name">${title}</div>
                <div class="suggestion-meta">${brand}</div>
              </div>
            </div>
          `;
        }).join('');

        suggestions.classList.add('show');

        document.querySelectorAll('.suggestion-item').forEach(item => {
          item.addEventListener('click', () => {
            searchInput.value = item.dataset.title || '';
            suggestions.classList.remove('show');
            updateProducts();
          });
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          updateProducts();
          updateSuggestions();
        });
      }

      if (clearSearch) {
        clearSearch.addEventListener('click', () => {
          searchInput.value = '';
          suggestions.classList.remove('show');
          updateProducts();
          searchInput.focus();
        });
      }

      if (btnAll) {
        btnAll.addEventListener('click', () => {
          currentCategory = '';
          btnAll.classList.add('active');
          categoryLabel.textContent = 'Categoría: Todas';
          categoryMenu.classList.remove('show');
          updateProducts();
        });
      }

      if (categoryTrigger) {
        categoryTrigger.addEventListener('click', () => {
          categoryMenu.classList.toggle('show');
        });
      }

      categoryOptions.forEach(option => {
        option.addEventListener('click', () => {
          currentCategory = option.dataset.category || '';
          btnAll.classList.remove('active');
          categoryLabel.textContent = `Categoría: ${currentCategory}`;
          categoryMenu.classList.remove('show');
          updateProducts();
        });
      });

      document.addEventListener('click', (event) => {
        if (
          categoryMenu &&
          categoryTrigger &&
          !categoryMenu.contains(event.target) &&
          !categoryTrigger.contains(event.target)
        ) {
          categoryMenu.classList.remove('show');
        }

        if (
          suggestions &&
          searchInput &&
          !suggestions.contains(event.target) &&
          !searchInput.contains(event.target)
        ) {
          suggestions.classList.remove('show');
        }
      });

      updateProducts();
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>